<?xml version="1.0" encoding="utf-8"?>
<!-- Halo's unit tests. Deliberately NOT in tools\build.ps1's publish list, so nothing here can
     reach dist\app: that script names the three shipping exes one by one. `dotnet build Halo.sln`
     and `dotnet test Halo.sln` both pick it up because it is in the solution.

     Scope: the parts of Halo that can be exercised without a running collector or a GPU —
     frame-stat arithmetic, section layout (on private section names), provider freshness, config
     load/write and the logger. Anything that needs live hardware or the PresentMon ETW session
     stays a hand check (the collector's pm-smoketest / tap-smoketest switches). -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Directory.Build.props pins RuntimeIdentifier=win-x64 for the shipping exes; the test
         host is happy with it and it keeps this project on the same restore graph. -->

    <!-- These two and Program.cs are ONE unit â€” remove any of the three and the build breaks.
         The cross-process config test spawns a second copy of itself, which needs a real
         apphost; a test project is OutputType=Library by default and produces none, so
         Environment.ProcessPath is testhost.exe and there is nothing to re-launch. OutputType
         then demands an entry point that GenerateProgramFile would otherwise synthesise, so
         Program.cs supplies it (and hands VSTest the normal path when no peer argument is
         present). Dropping the properties alone gives CS5001; dropping Program.cs alone does
         the same. Measured both ways, 2026-09-14. -->
    <OutputType>Exe</OutputType>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Halo.Collector\Halo.Collector.csproj" />
    <ProjectReference Include="..\..\src\Halo.Metrics\Halo.Metrics.csproj" />
    <ProjectReference Include="..\..\src\Halo.Shared\Halo.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Redirects Paths.DataDir into this project's own output folder.

       SessionLog has no path seam: Begin and RecordExternalStop always resolve
       Paths.LogsDir\sessions, and Paths.DataDir is %LOCALAPPDATA%\Halo with no setter
       (Paths.cs:38-58). Without this marker, SessionLogTests would read, reclassify, rewrite and
       prune the session records of a real Halo installation on the developer's machine, because
       ReportPrevious processes every file it finds in that directory. Paths.IsPortable is
       File.Exists(exeFolder\portable.marker), and AppContext.BaseDirectory under testhost.exe is
       this output folder (measured 2026-09-17), so the marker moves the data folder to
       bin\...\data and each worktree's tests get an isolated one.

       Beyond SessionLog, the suite reaches IsPortable only through Log.Init, which picks the file
       cap and sweep window by it; the other readers are code the tests never run. -->
  <ItemGroup>
    <Content Include="portable.marker" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
