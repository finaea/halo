<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Portable-first policy (docs/install-footprint.md): NuGet cache lives inside the project folder -->
  <config>
    <add key="globalPackagesFolder" value="tools/nuget-cache" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
