<UserControl x:Class="Halo.Settings.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="{StaticResource HaloPageBackground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,20,22,18">
      <StackPanel MaxWidth="760" HorizontalAlignment="Left">
        <TextBlock Text="About" Style="{StaticResource PageTitle}" />
        <TextBlock Text="Version details, project links and the people and software Halo builds on."
                   Style="{StaticResource PageSub}" />

        <Border x:Name="VersionSection" Style="{StaticResource SettingsCard}"
                Tag="about halo version settings collector protocol build">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="62" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Width="48" Height="48" CornerRadius="12" Background="#1673D1" VerticalAlignment="Top">
              <TextBlock Text="H" Foreground="White" FontSize="25" FontWeight="SemiBold"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1">
              <TextBlock Text="Halo" FontSize="22" FontWeight="SemiBold" />
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="Settings" Style="{StaticResource Hint}" />
                <TextBlock x:Name="SettingsVersionText" Grid.Column="1" />
              </Grid>
              <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="Collector" Style="{StaticResource Hint}" />
                <TextBlock x:Name="CollectorVersionText" Grid.Column="1" />
              </Grid>
              <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="Metrics protocol" Style="{StaticResource Hint}" />
                <TextBlock Grid.Column="1" Text="v2 · Local\Halo.Metrics.v2" />
              </Grid>
              <Button Content="Copy version info" HorizontalAlignment="Left" Padding="12,6" Margin="0,14,0,0"
                      Click="CopyVersion_Click" />
            </StackPanel>
          </Grid>
        </Border>

        <Border x:Name="ProjectSection" Style="{StaticResource SettingsCard}"
                Tag="project website github source open data config folder third party notices licenses open source">
          <StackPanel>
            <TextBlock Text="Project and files" Style="{StaticResource SectionHeading}" />
            <WrapPanel>
              <Button Content="Project website ↗" Padding="12,6" Margin="0,0,8,8" Click="Project_Click" />
              <Button x:Name="NoticesButton" Content="Third-party notices" Padding="12,6" Margin="0,0,8,8"
                      Click="Notices_Click" />
              <Button Content="Open Halo data folder" Padding="12,6" Margin="0,0,0,8" Click="DataFolder_Click" />
            </WrapPanel>
            <TextBlock x:Name="LinkStatusText" Style="{StaticResource Hint}" Margin="0,3,0,0" />
          </StackPanel>
        </Border>

        <Border x:Name="CreditSection" Style="{StaticResource SettingsCard}"
                Tag="credits attribution rainformer visual design pul53dr1v3r creative commons cc by nc license">
          <StackPanel>
            <TextBlock Text="Visual design credit" Style="{StaticResource SectionHeading}" />
            <TextBlock Text="Visual design based on Rainformer 3.1 HWiNFO Edition by Pul53dr1v3r, used under CC BY-NC 3.0."
                       TextWrapping="Wrap" />
            <TextBlock Text="Halo’s Settings UI is new; the desktop widgets retain Rainformer’s visual language and attribution."
                       Style="{StaticResource Hint}" Margin="0,6,0,0" />
            <Button Content="View Rainformer ↗" HorizontalAlignment="Left" Padding="12,6" Margin="0,12,0,0"
                    Click="Rainformer_Click" />
          </StackPanel>
        </Border>

        <TextBlock x:Name="NoSearchResults" Text="No About information matches this search."
                   Style="{StaticResource Hint}" FontSize="14" Visibility="Collapsed" Margin="0,12" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
