<UserControl x:Class="Halo.Settings.Pages.MetricsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="18,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="Live metrics" Style="{StaticResource PageTitle}"/>
      <TextBlock Style="{StaticResource PageSub}"
                 Text="Read-only view of everything the collector publishes right now — useful to check what a widget would show. Names ending in .max are session maxima. Refreshes every 2 s."/>
    </StackPanel>

    <DockPanel Grid.Row="1" Margin="0,0,0,10" LastChildFill="False">
      <TextBox DockPanel.Dock="Left" x:Name="FilterBox" Width="240" TextChanged="Filter_Changed"
               VerticalAlignment="Center" ToolTip="Filter by metric name (e.g. fps, gpu, net)"/>
      <TextBlock DockPanel.Dock="Left" Text="filter" Style="{StaticResource Hint}" Margin="8,0,0,0"/>
      <TextBlock DockPanel.Dock="Right" x:Name="Header" Foreground="{StaticResource Sub}" VerticalAlignment="Center"/>
    </DockPanel>

    <DataGrid Grid.Row="2" x:Name="MetricGrid" IsReadOnly="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80"/>
        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="110"/>
        <DataGridTextColumn Header="Rate (Hz)" Binding="{Binding Rate}" Width="90"/>
        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
        <DataGridTextColumn Header="Age (s)" Binding="{Binding Age}" Width="90"/>
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
