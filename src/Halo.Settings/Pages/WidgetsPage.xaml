<UserControl x:Class="Halo.Settings.Pages.WidgetsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Halo.Settings"
             xmlns:picker="clr-namespace:ColorPicker;assembly=ColorPicker">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <SolidColorBrush x:Key="HaloDropIndicator" Color="#0067C0" />
    <!-- The NumberBox style that keeps this page's boxes from rendering blank now lives in
         App.xaml, applied implicitly to every page. The twelve hard Width="72..120" attributes below
         survive only because MinWidth clamps up over them; see the comment there before changing
         either. -->

    <!-- A disabled widget used to look exactly like an enabled one apart from the switch, which
         has no on/off caption. Dim the row and say "Off" in words. -->
    <Style x:Key="RowText" TargetType="StackPanel">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Enabled}" Value="False">
          <Setter Property="Opacity" Value="0.45" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="RowOffLabel" TargetType="TextBlock">
      <Setter Property="Text" Value="Off" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Foreground" Value="{StaticResource HaloSubtleText}" />
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Enabled}" Value="False">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="EditorRow" TargetType="Grid">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="Margin" Value="0,2" />
    </Style>
    <Style x:Key="EditorLabel" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Resources>

  <Grid Background="{StaticResource HaloPageBackground}" Margin="24,20,24,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Widgets" Style="{StaticResource PageTitle}" />
        <TextBlock Text="Choose what each desktop widget shows and how it behaves. Changes are written live."
                   Style="{StaticResource PageSub}" Margin="0,0,0,12" />
      </StackPanel>
      <Button Grid.Column="1" x:Name="AddWidgetButton" Content="＋ Add widget" Padding="14,7"
              VerticalAlignment="Top" Click="AddWidget_Click" />
    </Grid>

    <StackPanel Grid.Row="1">
      <Border x:Name="ReadyBanner" Visibility="Collapsed" Background="#EAF7F0" BorderBrush="#660F7B4D"
              BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
        <StackPanel>
          <TextBlock Text="Halo is ready" FontWeight="SemiBold" Foreground="{StaticResource HaloSuccess}" />
          <TextBlock Text="Your default layout was created. Changes below apply live." Style="{StaticResource Hint}" Margin="0,2,0,0" />
        </StackPanel>
      </Border>
      <ui:InfoBar IsOpen="{Binding CollectorOffline}"
                  Severity="Informational" Title="Collector not running"
                  Message="{Binding CollectorHint}" IsClosable="False" Margin="0,0,0,12" />
    </StackPanel>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <!-- Width is restored in the constructor and remembered for the session. -->
        <ColumnDefinition x:Name="ListColumn" Width="236" MinWidth="180" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" MinWidth="420" />
      </Grid.ColumnDefinitions>

      <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="Transparent" ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                    Cursor="SizeWE" DragCompleted="ListSplitter_DragCompleted"
                    AutomationProperties.Name="Resize the widget list" />

      <Border Grid.Column="0" Style="{StaticResource SettingsCard}" Padding="7" Margin="0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <!-- Without this the rows size to their untrimmed text, the list scrolls sideways and the
               enable toggle sits off the right edge where nobody finds it. -->
          <ListBox x:Name="WidgetList" ItemsSource="{Binding Widgets}" SelectedItem="{Binding SelectedWidget, Mode=TwoWay}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   BorderThickness="0" Background="Transparent" AllowDrop="True"
                   PreviewMouseLeftButtonDown="WidgetList_PreviewMouseLeftButtonDown"
                   PreviewMouseMove="WidgetList_PreviewMouseMove" Drop="WidgetList_Drop"
                   DragOver="WidgetList_DragOver" DragLeave="WidgetList_DragLeave"
                   PreviewKeyDown="WidgetList_PreviewKeyDown">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="5,7" />
                <Setter Property="Margin" Value="0,1" />
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock Text="⋮⋮" Foreground="{StaticResource HaloSubtleText}" VerticalAlignment="Center" ToolTip="Drag to reorder" />
                  <StackPanel Grid.Column="1" Margin="5,0,8,0" Style="{StaticResource RowText}">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="Off" Style="{StaticResource RowOffLabel}" />
                  <ui:ToggleSwitch Grid.Column="3" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                   OnContent="" OffContent="" AutomationProperties.Name="Enable widget" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <!-- Sits in the ListBox's own cell so a y measured against WidgetList is a y here. -->
          <Canvas IsHitTestVisible="False" ClipToBounds="True">
            <Border x:Name="DropLine" Height="2" CornerRadius="1" Visibility="Collapsed"
                    Background="{StaticResource HaloDropIndicator}"
                    Width="{Binding ActualWidth, ElementName=WidgetList}" />
          </Canvas>
          <StackPanel Grid.Row="1">
            <Separator Margin="2,4" />
            <UniformGrid Columns="2">
              <Button Content="↑ Move up" Margin="2" Padding="5" Click="MoveUp_Click" />
              <Button Content="↓ Move down" Margin="2" Padding="5" Click="MoveDown_Click" />
              <Button Content="Duplicate" Margin="2" Padding="5" Click="Duplicate_Click" />
              <Button Content="Remove" Margin="2" Padding="5" Foreground="{StaticResource HaloDanger}" Click="Remove_Click" />
            </UniformGrid>
            <TextBlock Text="Alt+↑ / Alt+↓ also reorders" Style="{StaticResource Hint}" HorizontalAlignment="Center" Margin="0,4,0,0" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource SettingsCard}" Padding="0" Margin="0">
        <Grid DataContext="{Binding SelectedWidget}">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid Margin="18,14,18,6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{Binding DisplayName, TargetNullValue=Select a widget}" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Hint}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="Live" Foreground="{StaticResource HaloSuccess}" VerticalAlignment="Center" />
          </Grid>

          <TabControl Grid.Row="1" BorderThickness="0" Background="Transparent">
            <TabItem Header="Refresh &amp; graphs">
              <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,12">
                <StackPanel>
                  <Border Style="{StaticResource SettingsCard}" Visibility="{Binding HasRateSlider, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                      <Grid Style="{StaticResource EditorRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center"><TextBlock Text="Refresh rate" /><TextBlock Text="{Binding RateRangeText}" Style="{StaticResource Hint}" /></StackPanel>
                        <Slider Grid.Column="1" Minimum="0.5" Maximum="{Binding RateMaximum}" TickFrequency="0.5" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" SmallChange="0.5" LargeChange="1" Value="{Binding RateHz, Mode=TwoWay}" Margin="8,0" />
                        <ui:NumberBox Grid.Column="2" Minimum="0.5" Maximum="{Binding RateMaximum}" SmallChange="0.5" MaxDecimalPlaces="1" Value="{Binding RateHz, Mode=TwoWay}" />
                        <local:HelpTip Grid.Column="3" Tip="{Binding RateHelp}" />
                      </Grid>
                      <Separator />
                      <Grid Style="{StaticResource EditorRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Graph history" Style="{StaticResource EditorLabel}" /><StackPanel Grid.Column="1" Orientation="Horizontal"><ui:NumberBox Width="86" Minimum="10" Maximum="600" SmallChange="5" Value="{Binding HistoryS, Mode=TwoWay}" /><TextBlock Text="s" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel></Grid>
                      <Separator />
                      <Grid Style="{StaticResource EditorRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Graph height" Style="{StaticResource EditorLabel}" /><StackPanel Grid.Column="1" Orientation="Horizontal"><ui:NumberBox Width="86" Minimum="10" Maximum="200" SmallChange="5" Value="{Binding GraphHeight, Mode=TwoWay}" /><TextBlock Text="px" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel></Grid>
                      <Separator />
                      <Grid Style="{StaticResource EditorRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions><TextBlock Text="Graph style" Style="{StaticResource EditorLabel}" /><ComboBox Grid.Column="1" ItemsSource="{Binding GraphStyles}" SelectedItem="{Binding GraphStyle, Mode=TwoWay}" /></Grid>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource SettingsCard}" Visibility="{Binding IsEventDriven, Converter={StaticResource BoolToVisibility}}"><StackPanel><TextBlock Text="Event-driven refresh" FontWeight="SemiBold" /><TextBlock Text="Frame metrics repaint when a new frame arrives. A 5 Hz tick keeps the panel alive between events." Style="{StaticResource Hint}" Margin="0,4,0,0" /></StackPanel></Border>
                  <Button Content="Reset refresh &amp; graphs" HorizontalAlignment="Left" Style="{StaticResource SubtleButton}" Click="ResetRefresh_Click" />
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="Metrics">
              <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,12">
                <StackPanel>
                  <ItemsControl ItemsSource="{Binding Options}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource SettingsCard}">
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="175" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Label}" /><TextBlock Text="{Binding SourceHint}" Style="{StaticResource Hint}" /></StackPanel>
                            <Grid Grid.Column="1" Margin="8,0">
                              <ui:ToggleSwitch IsChecked="{Binding BoolValue, Mode=TwoWay}" OnContent="On" OffContent="Off" HorizontalAlignment="Left" Visibility="{Binding IsBoolean, Converter={StaticResource BoolToVisibility}}" />
                              <ui:NumberBox Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding NumberValue, Mode=TwoWay}" HorizontalAlignment="Left" Width="120" Visibility="{Binding IsNumber, Converter={StaticResource BoolToVisibility}}" />
                              <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice, Mode=TwoWay}" MinWidth="240" HorizontalAlignment="Left" Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibility}}" />
                              <TextBox Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" MinWidth="240" HorizontalAlignment="Left" Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}" />
                              <ItemsControl ItemsSource="{Binding HardwareChoices}" Visibility="{Binding IsChecklist, Converter={StaticResource BoolToVisibility}}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,3,14,3" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </Grid>
                            <local:HelpTip Grid.Column="2" Tip="{Binding Help}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBlock Text="Metrics" Style="{StaticResource SectionHeading}" Margin="0,6,0,8" />
                  <ItemsControl ItemsSource="{Binding MetricRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource SettingsCard}">
                          <StackPanel>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding MetricName}" Style="{StaticResource Hint}" /></StackPanel><ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Show, Mode=TwoWay}" OnContent="Shown" OffContent="Hidden" /></Grid>
                            <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Label" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" /><CheckBox Grid.Column="2" Content="Graph" IsChecked="{Binding Graph, Mode=TwoWay}" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsGraphable, Converter={StaticResource BoolToVisibility}}" /></Grid>
                            <Grid Margin="0,8,0,0">
                              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                              <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="52" /><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                              <TextBlock Text="Colour" VerticalAlignment="Center" />
                              <Grid Grid.Column="1"><Button Width="44" Height="30" Padding="3" Click="ColorButton_Click" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"><Border Background="{Binding Swatch}" BorderBrush="#55000000" BorderThickness="1" CornerRadius="4" /></Button><Popup IsOpen="{Binding IsPickerOpen, Mode=TwoWay}" StaysOpen="False" Placement="Right"><Border Background="White" BorderBrush="#55000000" BorderThickness="1" CornerRadius="8" Padding="10"><Border.Resources><!-- The picker draws its own chrome in hard-coded pixels: Width="50" Height="20" on the HSV/HSL     combo, Width="70" on the hex box, Width="40" Height="18" on the H/S/V/A fields and four     Height="20" slider rows, all sized for stock WPF at a small font. Halo's ambient chrome     overflows every one of them, which is the single cause behind all three defects: combo     clipped, hex box tight, alpha row sliced off the bottom.     Two halves are needed. Pinning FontSize on the picker is not enough on its own, because an     implicit style beats inheritance - so every control type the picker uses has to have     WPF-UI's style taken off it first, or the font never reaches it. The H/S/V/A and Hex     captions are TextBlocks and the tab strip is a TabItem; neither is an input control, and     resetting only TextBox/ComboBox leaves both at the app font. The tab strip is what slices     the alpha row: ColorSliders gives its TabControl 20px of margin, 20px of grid margin and     four 20px rows, so the header has to stay small for the fourth row to survive. --><Style TargetType="TextBlock" /><Style TargetType="TabControl" /><Style TargetType="Slider" /><Style TargetType="Button" /><Style TargetType="ToggleButton" /><Style TargetType="ComboBoxItem" /><Style TargetType="TextBox"><Setter Property="Padding" Value="1,0" /><Setter Property="MinHeight" Value="0" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style><Style TargetType="ComboBox"><Setter Property="Padding" Value="3,0" /><Setter Property="MinHeight" Value="0" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style><Style TargetType="Label"><Setter Property="Padding" Value="0,0,5,0" /><Setter Property="VerticalAlignment" Value="Center" /></Style><Style TargetType="TabItem"><Setter Property="Padding" Value="7,1" /><Setter Property="MinHeight" Value="0" /></Style></Border.Resources><picker:StandardColorPicker Width="320" Height="430" FontSize="11" ShowFractionalPart="False" SelectedColor="{Binding Color, Mode=TwoWay}" ShowAlpha="True" HexRepresentation="RGBA" /></Border></Popup></Grid>
                              <TextBox Grid.Column="2" Text="{Binding Hex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center" />
                              <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right"><ItemsControl ItemsSource="{Binding WarningValues}" Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><ui:NumberBox Width="72" Margin="6,0,0,0" Value="{Binding Value, Mode=TwoWay}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><StackPanel Orientation="Horizontal" Margin="8,0,0,0" Visibility="{Binding HasMax, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Max" VerticalAlignment="Center" Margin="0,0,5,0" /><ui:NumberBox Width="78" Minimum="100" Maximum="10000" SmallChange="100" Value="{Binding Max, Mode=TwoWay}" /></StackPanel><TextBlock Text="{Binding Unit}" VerticalAlignment="Center" Margin="6,0,0,0" /></StackPanel>
                              <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                         Text="Colours the graph line. Text on rows with warning thresholds follows the warning colours."
                                         Style="{StaticResource Hint}" Margin="0,5,0,0" />
                            </Grid>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Content="Reset metrics" HorizontalAlignment="Left" Style="{StaticResource SubtleButton}" Click="ResetMetrics_Click" />
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="Appearance">
              <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,12">
                <StackPanel>
                  <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                      <Grid Style="{StaticResource EditorRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Title override" Style="{StaticResource EditorLabel}" /><TextBox Grid.Column="1" Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" /></Grid>
                      <Separator />
                      <Grid Style="{StaticResource EditorRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Font" Style="{StaticResource EditorLabel}" /><ComboBox Grid.Column="1" ItemsSource="{Binding FontFamilies}" Text="{Binding FontFamily, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" IsEditable="True" IsEnabled="{Binding IsFontOverrideEnabled}" /><CheckBox Grid.Column="2" Content="Use global" IsChecked="{Binding UseGlobalFont, Mode=TwoWay}" Margin="10,0,0,0" VerticalAlignment="Center" /></Grid>
                      <Separator />
                      <Grid Style="{StaticResource EditorRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Scale" Style="{StaticResource EditorLabel}" /><StackPanel Grid.Column="1" Orientation="Horizontal"><ui:NumberBox Width="90" Minimum="1" Maximum="3.5" SmallChange="0.05" Value="{Binding Scale, Mode=TwoWay}" IsEnabled="{Binding IsScaleOverrideEnabled}" /><ui:ToggleSwitch Margin="8,0,0,0" IsChecked="{Binding ScaleAuto, Mode=TwoWay}" OnContent="Auto" OffContent="Fixed" IsEnabled="{Binding IsScaleOverrideEnabled}" /></StackPanel><CheckBox Grid.Column="2" Content="Use global" IsChecked="{Binding UseGlobalScale, Mode=TwoWay}" Margin="10,0,0,0" VerticalAlignment="Center" /></Grid>
                      <Separator />
                      <Grid Style="{StaticResource EditorRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Show title" Style="{StaticResource EditorLabel}" /><ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowTitle, Mode=TwoWay}" OnContent="Shown" OffContent="Hidden" IsEnabled="{Binding IsShowTitleOverrideEnabled}" HorizontalAlignment="Left" /><CheckBox Grid.Column="2" Content="Use global" IsChecked="{Binding UseGlobalShowTitle, Mode=TwoWay}" Margin="10,0,0,0" VerticalAlignment="Center" /></Grid>
                      <Separator />
                      <Grid Style="{StaticResource EditorRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Panel width" Style="{StaticResource EditorLabel}" /><StackPanel Grid.Column="1" Orientation="Horizontal"><ui:NumberBox Width="90" Minimum="120" Maximum="800" SmallChange="5" Value="{Binding Width, Mode=TwoWay}" IsEnabled="{Binding IsWidthOverrideEnabled}" /><TextBlock Text="px" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel><CheckBox Grid.Column="2" Content="Use global" IsChecked="{Binding UseGlobalWidth, Mode=TwoWay}" Margin="10,0,0,0" VerticalAlignment="Center" /></Grid>
                      <Grid Style="{StaticResource EditorRow}" Visibility="{Binding HasTemperature, Converter={StaticResource BoolToVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Temperature unit" Style="{StaticResource EditorLabel}" /><ComboBox Grid.Column="1" Width="190" HorizontalAlignment="Left" ItemsSource="{Binding TemperatureUnits}" SelectedItem="{Binding TempUnit, Mode=TwoWay}" /></Grid>
                    </StackPanel>
                  </Border>
                  <ItemsControl ItemsSource="{Binding AppearanceColors}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource SettingsCard}">
                          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="52" /><ColumnDefinition Width="105" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" VerticalAlignment="Center" /><Grid Grid.Column="1"><Button Width="44" Height="30" Padding="3" Click="ColorButton_Click" IsEnabled="{Binding IsEnabled}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"><Border Background="{Binding Swatch}" BorderBrush="#55000000" BorderThickness="1" CornerRadius="4" /></Button><Popup IsOpen="{Binding IsPickerOpen, Mode=TwoWay}" StaysOpen="False" Placement="Right"><Border Background="White" BorderBrush="#55000000" BorderThickness="1" CornerRadius="8" Padding="10"><Border.Resources><!-- The picker draws its own chrome in hard-coded pixels: Width="50" Height="20" on the HSV/HSL     combo, Width="70" on the hex box, Width="40" Height="18" on the H/S/V/A fields and four     Height="20" slider rows, all sized for stock WPF at a small font. Halo's ambient chrome     overflows every one of them, which is the single cause behind all three defects: combo     clipped, hex box tight, alpha row sliced off the bottom.     Two halves are needed. Pinning FontSize on the picker is not enough on its own, because an     implicit style beats inheritance - so every control type the picker uses has to have     WPF-UI's style taken off it first, or the font never reaches it. The H/S/V/A and Hex     captions are TextBlocks and the tab strip is a TabItem; neither is an input control, and     resetting only TextBox/ComboBox leaves both at the app font. The tab strip is what slices     the alpha row: ColorSliders gives its TabControl 20px of margin, 20px of grid margin and     four 20px rows, so the header has to stay small for the fourth row to survive. --><Style TargetType="TextBlock" /><Style TargetType="TabControl" /><Style TargetType="Slider" /><Style TargetType="Button" /><Style TargetType="ToggleButton" /><Style TargetType="ComboBoxItem" /><Style TargetType="TextBox"><Setter Property="Padding" Value="1,0" /><Setter Property="MinHeight" Value="0" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style><Style TargetType="ComboBox"><Setter Property="Padding" Value="3,0" /><Setter Property="MinHeight" Value="0" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style><Style TargetType="Label"><Setter Property="Padding" Value="0,0,5,0" /><Setter Property="VerticalAlignment" Value="Center" /></Style><Style TargetType="TabItem"><Setter Property="Padding" Value="7,1" /><Setter Property="MinHeight" Value="0" /></Style></Border.Resources><picker:StandardColorPicker Width="320" Height="430" FontSize="11" ShowFractionalPart="False" SelectedColor="{Binding Color, Mode=TwoWay}" ShowAlpha="True" HexRepresentation="RGBA" /></Border></Popup></Grid><TextBox Grid.Column="2" Text="{Binding Hex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding IsEnabled}" /><CheckBox Grid.Column="3" Content="Use global" IsChecked="{Binding UseGlobal, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Content="Use global for all" HorizontalAlignment="Left" Style="{StaticResource SubtleButton}" Click="UseGlobal_Click" />
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="Placement">
              <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,12">
                <StackPanel>
                  <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                      <Grid Style="{StaticResource EditorRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Monitor" Style="{StaticResource EditorLabel}" /><ComboBox Grid.Column="1" ItemsSource="{Binding MonitorChoices}" SelectedItem="{Binding Monitor, Mode=TwoWay}" /></Grid>
                      <Separator />
                      <Grid Style="{StaticResource EditorRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Position X / Y" Style="{StaticResource EditorLabel}" /><StackPanel Grid.Column="1" Orientation="Horizontal"><ui:NumberBox Width="100" Value="{Binding X, Mode=TwoWay}" /><ui:NumberBox Width="100" Value="{Binding Y, Mode=TwoWay}" Margin="8,0,0,0" /></StackPanel></Grid>
                      <Separator />
                      <Grid Style="{StaticResource EditorRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Z-order" Style="{StaticResource EditorLabel}" /><ComboBox Grid.Column="1" ItemsSource="{Binding ZModes}" SelectedItem="{Binding ZMode, Mode=TwoWay}" /><local:HelpTip Grid.Column="2" Tip="On desktop stays above the wallpaper and below ordinary windows. Normal behaves like an app window. Always on top floats over other windows." /></Grid>
                      <Separator />
                      <Grid Style="{StaticResource EditorRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions><TextBlock Text="Opacity" Style="{StaticResource EditorLabel}" /><Slider Grid.Column="1" Minimum="0.1" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" SmallChange="0.05" LargeChange="0.1" Value="{Binding Opacity, Mode=TwoWay}" Margin="0,0,10,0" /><TextBlock Grid.Column="2" Text="{Binding Opacity, StringFormat={}{0:P0}}" VerticalAlignment="Center" /></Grid>
                      <Separator />
                      <Grid Style="{StaticResource EditorRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Click-through" /><TextBlock Text="Mouse clicks pass to whatever is underneath." Style="{StaticResource Hint}" /></StackPanel><ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding ClickThrough, Mode=TwoWay}" OnContent="On" OffContent="Off" /></Grid>
                      <Grid Style="{StaticResource EditorRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Keep on screen" /><TextBlock Text="Clamps the widget inside its monitor." Style="{StaticResource Hint}" /></StackPanel><ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding KeepOnScreen, Mode=TwoWay}" OnContent="On" OffContent="Off" /></Grid>
                      <Grid Style="{StaticResource EditorRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Lock this widget" /><TextBlock Text="Prevents accidental dragging." Style="{StaticResource Hint}" /></StackPanel><ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Locked, Mode=TwoWay}" OnContent="On" OffContent="Off" /></Grid>
                      <Grid Style="{StaticResource EditorRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Hide over fullscreen apps" /><TextBlock Text="Useful for games and video playback." Style="{StaticResource Hint}" /></StackPanel><ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding HideOnFullscreen, Mode=TwoWay}" OnContent="On" OffContent="Off" /></Grid>
                    </StackPanel>
                  </Border>
                  <Button Content="Reset placement" HorizontalAlignment="Left" Style="{StaticResource SubtleButton}" Click="ResetPlacement_Click" />
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="Data source">
              <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,12">
                <StackPanel>
                  <Border Style="{StaticResource SettingsCard}" Visibility="{Binding HasNetworkDataSource, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel><TextBlock Text="Network data" Style="{StaticResource SectionHeading}" /><TextBlock Text="Shared by every Network widget — these are collector settings, not this widget's." Style="{StaticResource Hint}" Margin="0,0,0,6" /><Grid Style="{StaticResource EditorRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Network adapter" Style="{StaticResource EditorLabel}" /><ComboBox Grid.Column="1" ItemsSource="{Binding NetworkAdapterChoices}" IsEditable="True" Text="{Binding NetworkInterface, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" /></Grid><Grid Style="{StaticResource EditorRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="External IP" /><TextBlock Text="Off by default. Halo's only outbound web request." Style="{StaticResource Hint}" /></StackPanel><ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding ExternalIpEnabled, Mode=TwoWay}" OnContent="On" OffContent="Off" /></Grid><Grid Style="{StaticResource EditorRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Service URL" Style="{StaticResource EditorLabel}" /><TextBox Grid.Column="1" Text="{Binding ExternalIpUrl, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding ExternalIpEnabled}" /></Grid><Grid Style="{StaticResource EditorRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Refresh interval" Style="{StaticResource EditorLabel}" /><StackPanel Grid.Column="1" Orientation="Horizontal"><ui:NumberBox Width="90" Minimum="1" Maximum="1440" Value="{Binding ExternalIpRefresh, Mode=TwoWay}" IsEnabled="{Binding ExternalIpEnabled}" /><TextBlock Text="minutes" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel></Grid></StackPanel>
                  </Border>
                  <Border Style="{StaticResource SettingsCard}" Visibility="{Binding HasFpsDataSource, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel><TextBlock Text="Frame data" Style="{StaticResource SectionHeading}" /><TextBlock Text="Shared by every FPS widget — these are collector settings, not this widget's." Style="{StaticResource Hint}" Margin="0,0,0,6" /><Grid Style="{StaticResource EditorRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Capture transport" Style="{StaticResource EditorLabel}" /><ComboBox Grid.Column="1" ItemsSource="{Binding TransportChoices}" SelectedItem="{Binding Transport, Mode=TwoWay}" /></Grid><Grid Style="{StaticResource EditorRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Presented tap" Style="{StaticResource EditorLabel}" /><ComboBox Grid.Column="1" ItemsSource="{Binding TapChoices}" SelectedItem="{Binding Tap, Mode=TwoWay}" /></Grid><Grid Style="{StaticResource EditorRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="ETW flush period" Style="{StaticResource EditorLabel}" /><StackPanel Grid.Column="1" Orientation="Horizontal"><ui:NumberBox Width="90" Minimum="0" Maximum="1000" Value="{Binding FlushMs, Mode=TwoWay}" /><TextBlock Text="ms" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel></Grid><Grid Style="{StaticResource EditorRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="1% / 0.1% lows window" Style="{StaticResource EditorLabel}" /><StackPanel Grid.Column="1" Orientation="Horizontal"><ui:NumberBox Width="90" Minimum="10" Maximum="600" Value="{Binding LowsWindow, Mode=TwoWay}" /><TextBlock Text="s" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel></Grid></StackPanel>
                  </Border>
                  <Border Style="{StaticResource SettingsCard}" Visibility="{Binding HasNoDataSource, Converter={StaticResource BoolToVisibility}}"><StackPanel><TextBlock Text="No widget-specific data source" FontWeight="SemiBold" /><TextBlock Text="This widget follows the collector's automatic hardware discovery." Style="{StaticResource Hint}" Margin="0,4,0,0" /></StackPanel></Border>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
          </TabControl>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
