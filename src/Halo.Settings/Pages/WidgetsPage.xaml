<UserControl x:Class="Halo.Settings.Pages.WidgetsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="18,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Widgets" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <ListBox Grid.Column="0" x:Name="WidgetList" SelectionChanged="WidgetList_SelectionChanged">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="2,3">
              <TextBlock Text="{Binding Id}" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding Type}" Foreground="{StaticResource Sub}" FontSize="11"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="Detail">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="Id"/>
          <TextBlock Grid.Row="0" Grid.Column="1" x:Name="IdText" Margin="0,4"/>

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Type"/>
          <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TypeText" Margin="0,4"/>

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Monitor (device id)"/>
          <TextBox   Grid.Row="2" Grid.Column="1" x:Name="MonitorBox" Width="260" HorizontalAlignment="Left" Margin="0,4"/>

          <TextBlock Grid.Row="3" Grid.Column="0" Text="X"/>
          <TextBox   Grid.Row="3" Grid.Column="1" x:Name="XBox" Width="120" HorizontalAlignment="Left" Margin="0,4"/>

          <TextBlock Grid.Row="4" Grid.Column="0" Text="Y"/>
          <TextBox   Grid.Row="4" Grid.Column="1" x:Name="YBox" Width="120" HorizontalAlignment="Left" Margin="0,4"/>

          <TextBlock Grid.Row="5" Grid.Column="0" Text="Z mode"/>
          <ComboBox  Grid.Row="5" Grid.Column="1" x:Name="ZModeCombo" Width="160" HorizontalAlignment="Left" Margin="0,4"/>

          <TextBlock Grid.Row="6" Grid.Column="0" Text="Opacity (0.1..1)"/>
          <TextBox   Grid.Row="6" Grid.Column="1" x:Name="OpacityBox" Width="120" HorizontalAlignment="Left" Margin="0,4"/>

          <TextBlock Grid.Row="7" Grid.Column="0" Text="Rate (Hz, empty = default)"/>
          <TextBox   Grid.Row="7" Grid.Column="1" x:Name="RateBox" Width="120" HorizontalAlignment="Left" Margin="0,4"/>

          <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal">
            <CheckBox x:Name="EnabledCheck" Content="Enabled" Margin="0,4,16,4"/>
            <CheckBox x:Name="ClickThroughCheck" Content="Click-through" Margin="0,4,16,4"/>
          </StackPanel>
          <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal">
            <CheckBox x:Name="KeepOnScreenCheck" Content="Keep on screen" Margin="0,4,16,4"/>
            <CheckBox x:Name="LockedCheck" Content="Locked" Margin="0,4,16,4"/>
          </StackPanel>

          <TextBlock Grid.Row="10" Grid.Column="0" Text="Options (key=value per line)" VerticalAlignment="Top" Margin="0,6,0,0"/>
          <TextBox   Grid.Row="10" Grid.Column="1" x:Name="OptionsBox" Margin="0,4"
                     Height="130" AcceptsReturn="True" AcceptsTab="False"
                     VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                     FontFamily="Consolas" VerticalContentAlignment="Top"/>
        </Grid>
      </ScrollViewer>
    </Grid>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
      <Button Content="Save" Click="Save_Click"/>
      <TextBlock x:Name="Status" Foreground="{StaticResource Sub}" VerticalAlignment="Center" TextWrapping="Wrap"/>
    </StackPanel>
  </Grid>
</UserControl>
