<UserControl x:Class="Halo.Settings.Pages.WidgetsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Halo.Settings">
  <Grid Margin="18,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="Widgets" Style="{StaticResource PageTitle}"/>
      <TextBlock Style="{StaticResource PageSub}"
                 Text="Tick a widget to show it on the desktop. Position, lock, opacity and z-order can also be changed by dragging / right-clicking the widget itself — those changes save instantly."/>
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <ListBox Grid.Column="0" x:Name="WidgetList" SelectionChanged="WidgetList_SelectionChanged">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <DockPanel Margin="2,3">
              <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,10,0"
                        IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Show this widget on the desktop (takes effect on Save)"/>
              <StackPanel>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Sub}" Foreground="{StaticResource Sub}" FontSize="11"/>
              </StackPanel>
            </DockPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Detail" MaxWidth="620" HorizontalAlignment="Left">
          <TextBlock x:Name="NameText" FontSize="15" FontWeight="SemiBold"/>
          <TextBlock x:Name="SubText" Style="{StaticResource Hint}" Margin="0,2,0,10"/>

          <GroupBox Header="Title">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Title" Style="{StaticResource RowLabel}"/>
              <TextBox   Grid.Column="1" x:Name="TitleBox" Width="320" HorizontalAlignment="Left" Margin="0,4"/>
              <local:HelpTip Grid.Column="2"
                             Tip="Text in this widget's title bar. Leave empty for the panel's own default, which for CPU and GPU widgets is the live device name."/>
            </Grid>
          </GroupBox>

          <GroupBox Header="Placement">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Text="Monitor" Style="{StaticResource RowLabel}"/>
              <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="MonitorCombo" Width="320"
                         HorizontalAlignment="Left" Margin="0,4"/>
              <local:HelpTip Grid.Row="0" Grid.Column="2"
                             Tip="Which monitor the position below is relative to. Dragging the widget onto another monitor updates this automatically on drop."/>

              <TextBlock Grid.Row="1" Grid.Column="0" Text="Position X / Y" Style="{StaticResource RowLabel}"/>
              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                <TextBox x:Name="XBox" Width="80"/>
                <TextBox x:Name="YBox" Width="80" Margin="8,0,0,0"/>
              </StackPanel>
              <local:HelpTip Grid.Row="1" Grid.Column="2"
                             Tip="Pixels from the top-left of the monitor's work area. Easiest way to position a widget: just drag it on the desktop — the drop is saved automatically."/>

              <TextBlock Grid.Row="2" Grid.Column="0" Text="Z-order" Style="{StaticResource RowLabel}"/>
              <ComboBox  Grid.Row="2" Grid.Column="1" x:Name="ZModeCombo" Width="320"
                         HorizontalAlignment="Left" Margin="0,4"/>
              <local:HelpTip Grid.Row="2" Grid.Column="2"
                             Tip="Where the widget lives in the window stack.&#x0a;&#x0a;• On desktop — glued above the wallpaper, under every window; survives Win+D (recommended).&#x0a;• Normal — behaves like an ordinary window.&#x0a;• Always on top — floats above everything, including games in windowed mode."/>

              <CheckBox Grid.Row="3" Grid.Column="1" x:Name="KeepOnScreenCheck" Content="Keep on screen" Margin="0,6"/>
              <local:HelpTip Grid.Row="3" Grid.Column="2"
                             Tip="Clamps the widget inside the monitor it sits on, so it can never end up stranded off-screen after resolution or monitor changes."/>
            </Grid>
          </GroupBox>

          <GroupBox Header="Behavior">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Text="Opacity" Style="{StaticResource RowLabel}"/>
              <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                <Slider x:Name="OpacitySlider" Width="240" Minimum="0.1" Maximum="1.0"
                        TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                <TextBlock Margin="10,0,0,0" Width="40"
                           Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:P0}}"/>
              </StackPanel>
              <local:HelpTip Grid.Row="0" Grid.Column="2"
                             Tip="Overall transparency of this widget (also in its right-click menu)."/>

              <TextBlock Grid.Row="1" Grid.Column="0" Text="Refresh rate (Hz)" Style="{StaticResource RowLabel}"/>
              <TextBox   Grid.Row="1" Grid.Column="1" x:Name="RateBox" Width="80" HorizontalAlignment="Left" Margin="0,4"/>
              <local:HelpTip Grid.Row="1" Grid.Column="2"
                             Tip="How often this widget repaints. Raising it past the rate its data is published at does not make the numbers fresher — the collector's cadences are fixed. FPS panels repaint on real frame events regardless."/>
              <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource Hint}" Margin="12,0,0,0"
                         Text="0.5 – 10 · default 5"/>

              <CheckBox Grid.Row="2" Grid.Column="1" x:Name="ClickThroughCheck" Content="Click-through" Margin="0,6"/>
              <local:HelpTip Grid.Row="2" Grid.Column="2"
                             Tip="Mouse clicks pass through the widget to whatever is underneath. You lose drag and the right-click menu on the widget itself — come back here (or use the tray icon) to turn it off."/>

              <CheckBox Grid.Row="3" Grid.Column="1" x:Name="LockedCheck" Content="Lock position" Margin="0,6"/>
              <local:HelpTip Grid.Row="3" Grid.Column="2"
                             Tip="Blocks dragging this widget so it cannot be moved by accident. The right-click menu keeps working."/>
            </Grid>
          </GroupBox>

          <GroupBox x:Name="GraphLinesGroup" Header="Graph lines" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                         Text="Untick a line to hide it from this widget's graph. Changes take effect on Save."/>
              <StackPanel x:Name="GraphLinesPanel"/>
            </StackPanel>
          </GroupBox>

          <GroupBox Header="Panel options">
            <StackPanel>
              <TextBox x:Name="OptionsBox" Height="90" AcceptsReturn="True" AcceptsTab="False"
                       VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                       FontFamily="Consolas" VerticalContentAlignment="Top"/>
              <TextBlock x:Name="OptionsHint" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
            </StackPanel>
          </GroupBox>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
      <Button Content="Save" Click="Save_Click" FontWeight="SemiBold" Padding="20,5"/>
      <TextBlock x:Name="Status" Foreground="{StaticResource Sub}" VerticalAlignment="Center" TextWrapping="Wrap"/>
    </StackPanel>
  </Grid>
</UserControl>
