<UserControl x:Class="Halo.Settings.Pages.PlaceholderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="{StaticResource HaloPageBackground}">
    <StackPanel Margin="32" MaxWidth="760" HorizontalAlignment="Left" VerticalAlignment="Top">
      <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}" />
      <TextBlock x:Name="BodyText" Style="{StaticResource PageSub}" />
    </StackPanel>
  </Grid>
</UserControl>
