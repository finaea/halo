<UserControl x:Class="Halo.Settings.Pages.SystemCheckPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>

  <Grid Background="{StaticResource HaloPageBackground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,20,22,18">
      <StackPanel MaxWidth="900" HorizontalAlignment="Stretch">
        <TextBlock Text="System check" Style="{StaticResource PageTitle}" />
        <TextBlock Text="See what Halo detected, what needs attention, and which widgets can show live data."
                   Style="{StaticResource PageSub}" />

        <Border x:Name="FirstRunBanner" Background="#EAF3FC" BorderBrush="#681673D1" BorderThickness="1"
                CornerRadius="8" Padding="16,13" Margin="0,0,0,12"
                Visibility="{Binding IsFirstRun, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <TextBlock Text="Let’s set up your widgets" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="Nothing has been written yet. Review the checks below, then generate a sensible starting layout."
                       Style="{StaticResource Hint}" Margin="0,4,0,0" />
          </StackPanel>
        </Border>

        <Border x:Name="OfflineBanner" Background="#FFF8E8" BorderBrush="#80B77900" BorderThickness="1"
                CornerRadius="8" Padding="16,12" Margin="0,0,0,12"
                Visibility="{Binding Offline, Converter={StaticResource BoolToVisibility}}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Collector not running" FontWeight="SemiBold" />
              <TextBlock Text="Live providers and hardware cannot be checked. A basic Clock, CPU/RAM and Network layout is still available."
                         Style="{StaticResource Hint}" Margin="0,3,12,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Retry" Padding="12,5" VerticalAlignment="Center" Click="Retry_Click" />
          </Grid>
        </Border>

        <TextBlock Text="At a glance" Style="{StaticResource SectionHeading}" />
        <ItemsControl x:Name="SummarySection" ItemsSource="{Binding SummaryCards}"
                      Tag="summary collector administrator elevation pawnio driver autostart widget readiness status">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource SettingsCard}" Margin="0,0,10,10" MinHeight="88">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Border Width="25" Height="25" CornerRadius="13" Background="{Binding StatusBrush}" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Glyph}" Foreground="White" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border x:Name="ActionsSection" Style="{StaticResource SettingsCard}"
                Tag="actions install pawnio driver repair autostart scheduled tasks rescan hardware copy report generate default layout">
          <StackPanel>
            <TextBlock Text="Fixes and setup" Style="{StaticResource SectionHeading}" />
            <WrapPanel>
              <Button Content="{Binding PawnIoButtonText}" IsEnabled="{Binding CanInstallPawnIo}"
                      ToolTip="{Binding PawnIoButtonToolTip}" Padding="12,6" Margin="0,0,8,8" Click="InstallPawnIo_Click" />
              <Button Content="Repair autostart…  ⛨" IsEnabled="{Binding CanRepairAutostart}"
                      ToolTip="{Binding AutostartButtonToolTip}" Padding="12,6" Margin="0,0,8,8" Click="RepairAutostart_Click" />
              <Button Content="Rescan hardware" IsEnabled="{Binding CanRescan}"
                      ToolTip="Re-enumerates GPUs, fans and volumes. Available once every 10 seconds."
                      Padding="12,6" Margin="0,0,8,8" Click="Rescan_Click" />
              <Button Content="Copy hardware report" Padding="12,6" Margin="0,0,8,8" Click="CopyReport_Click" />
              <Button Content="Generate default layout" Padding="12,6" Margin="0,0,0,8" Click="GenerateLayout_Click" />
            </WrapPanel>
            <TextBlock Text="{Binding ActionStatus}" Style="{StaticResource Hint}" Margin="0,2,0,0" />
          </StackPanel>
        </Border>

        <Border x:Name="HardwareSection" Style="{StaticResource SettingsCard}"
                Tag="hardware detected windows os cpu gpu graphics volume drive disk fan sensors">
          <StackPanel>
            <TextBlock Text="Detected hardware" Style="{StaticResource SectionHeading}" />
            <ItemsControl ItemsSource="{Binding Hardware}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{StaticResource HaloBorder}" BorderThickness="1" CornerRadius="6"
                          Background="#06000000" Padding="12,9" Margin="0,0,8,8" MinWidth="190" MaxWidth="330">
                    <StackPanel>
                      <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border x:Name="ProvidersSection" Style="{StaticResource SettingsCard}"
                Tag="providers status collector builtin kernel process disk io network nvml lhm presentmon pclstats error polling rate">
          <StackPanel>
            <TextBlock Text="Data providers" Style="{StaticResource SectionHeading}" />
            <Grid Margin="0,3,0,5">
              <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="105" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Text="Provider" Style="{StaticResource Hint}" />
              <TextBlock Grid.Column="1" Text="Status" Style="{StaticResource Hint}" />
              <TextBlock Grid.Column="2" Text="Detail" Style="{StaticResource Hint}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Providers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid MinHeight="34">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="105" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Glyph}" Foreground="{Binding StatusBrush}" FontWeight="Bold" Margin="0,0,6,0" />
                      <TextBlock Text="{Binding Status}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Reason}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Start the collector to list its providers." Margin="0,4,0,0">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers><DataTrigger Binding="{Binding Offline}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Border>

        <Border x:Name="ReadinessSection" Style="{StaticResource SettingsCard}"
                Tag="widget readiness available partial unavailable clock cpu ram gpu fps network drives fans power latency top processes">
          <StackPanel>
            <TextBlock Text="Widget readiness" Style="{StaticResource SectionHeading}" />
            <ItemsControl ItemsSource="{Binding PanelStatuses}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid MinHeight="60" Margin="0,0,14,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Glyph}" Foreground="{Binding StatusBrush}" FontSize="18" FontWeight="Bold" />
                    <StackPanel Grid.Column="1">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="  ·  " />
                        <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" />
                      </StackPanel>
                      <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <TextBlock x:Name="NoSearchResults" Text="No System check settings match this search."
                   Style="{StaticResource Hint}" FontSize="14" Visibility="Collapsed" Margin="0,12" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
