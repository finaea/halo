<UserControl x:Class="Halo.Settings.Pages.GeneralPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:picker="clr-namespace:ColorPicker;assembly=ColorPicker">
  <Grid Background="{StaticResource HaloPageBackground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,22">
      <StackPanel MaxWidth="860" HorizontalAlignment="Left">
        <TextBlock Text="General" Style="{StaticResource PageTitle}" />
        <TextBlock Text="Desktop behaviour and defaults shared by every widget. Changes are written live."
                   Style="{StaticResource PageSub}" />

        <ui:InfoBar x:Name="PageInfoBar" IsOpen="False" IsClosable="True" Margin="0,0,0,12" />

        <Border x:Name="DesktopCard" Style="{StaticResource SettingsCard}" Tag="desktop start windows autostart lock snap">
          <StackPanel>
            <TextBlock Text="Desktop behaviour" Style="{StaticResource SectionHeading}" />
            <Grid x:Name="AutostartRow" Style="{StaticResource SettingsRow}" Tag="start windows autostart collector widgets scheduled tasks repair">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Start with Windows" />
                <TextBlock x:Name="AutostartStatusText" Text="Checking Collector and Widgets tasks…" Style="{StaticResource Hint}" />
              </StackPanel>
              <ui:ToggleSwitch x:Name="AutostartSwitch" Grid.Column="1" VerticalAlignment="Center"
                               OnContent="On" OffContent="Off" Click="AutostartSwitch_Click" />
            </Grid>
            <Separator />
            <Grid x:Name="LockRow" Style="{StaticResource SettingsRow}" Tag="lock all widgets position">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Lock all widgets" />
                <TextBlock Text="Blocks dragging without changing each widget's own lock setting." Style="{StaticResource Hint}" />
              </StackPanel>
              <ui:ToggleSwitch x:Name="LockAllSwitch" Grid.Column="1" IsChecked="{Binding LockAll, Mode=TwoWay}"
                               OnContent="On" OffContent="Off" AutomationProperties.Name="Lock all widgets" />
            </Grid>
            <Separator />
            <Grid x:Name="SnapRow" Style="{StaticResource SettingsRow}" Tag="snap moving drag edges">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Snap while moving" />
                <TextBlock Text="Pulls widgets to screen and widget edges while you drag." Style="{StaticResource Hint}" />
              </StackPanel>
              <ui:ToggleSwitch x:Name="SnapSwitch" Grid.Column="1" IsChecked="{Binding Snap, Mode=TwoWay}"
                               OnContent="On" OffContent="Off" AutomationProperties.Name="Snap while moving" />
            </Grid>
            <Button x:Name="RepairAutostartButton" Content="Repair autostart…  ⛨" HorizontalAlignment="Left"
                    Style="{StaticResource SubtleButton}" Margin="0,8,0,0" Click="RepairAutostart_Click"
                    ToolTip="Recreates both scheduled tasks and asks Windows for administrator permission." />
          </StackPanel>
        </Border>

        <Border x:Name="AppearanceCard" Style="{StaticResource SettingsCard}" Tag="appearance theme palette scale font text corner radius colours">
          <StackPanel>
            <TextBlock Text="Appearance defaults" Style="{StaticResource SectionHeading}" />
            <TextBlock Text="Theme presets write ordinary colours; you can change any swatch afterward." Style="{StaticResource Hint}" Margin="0,0,0,8" />
            <WrapPanel x:Name="PresetRow" Margin="0,0,0,8" Tag="theme presets Rainformer Light High contrast">
              <Button Content="Rainformer" Tag="Rainformer" Click="Preset_Click" Style="{StaticResource SubtleButton}" />
              <Button Content="Light" Tag="Light" Click="Preset_Click" Style="{StaticResource SubtleButton}" />
              <Button Content="High contrast" Tag="High contrast" Click="Preset_Click" Style="{StaticResource SubtleButton}" />
            </WrapPanel>
            <Separator />
            <Grid x:Name="ScaleRow" Style="{StaticResource SettingsRow}" Tag="widget scale auto size primary monitor">
              <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Scale" />
                <TextBlock Text="{Binding ScaleSummary}" Style="{StaticResource Hint}" />
              </StackPanel>
              <Slider Grid.Column="1" Minimum="1" Maximum="3.5" TickFrequency="0.05" IsSnapToTickEnabled="True"
                      Value="{Binding FixedScale, Mode=TwoWay}" IsEnabled="{Binding IsFixedScaleEnabled}" Margin="8,0" />
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:NumberBox Width="86" Minimum="1" Maximum="3.5" SmallChange="0.05" MaxDecimalPlaces="2"
                              Value="{Binding FixedScale, Mode=TwoWay}" IsEnabled="{Binding IsFixedScaleEnabled}" />
                <ui:ToggleSwitch Margin="10,0,0,0" IsChecked="{Binding AutoScale, Mode=TwoWay}" OnContent="Auto" OffContent="Fixed" />
              </StackPanel>
            </Grid>
            <Separator />
            <Grid x:Name="FontRow" Style="{StaticResource SettingsRow}" Tag="font family text size pt">
              <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="Font and text size" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" Width="280" HorizontalAlignment="Left" IsEditable="True"
                        ItemsSource="{Binding FontFamilies}" Text="{Binding FontFamily, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:NumberBox Width="86" Minimum="5" Maximum="24" SmallChange="0.5" MaxDecimalPlaces="1"
                              Value="{Binding TextSizePt, Mode=TwoWay}" />
                <TextBlock Text="pt" Margin="6,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
            <Separator />
            <Grid x:Name="CornerRow" Style="{StaticResource SettingsRow}" Tag="corner radius rounded panel">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="Corner radius" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:NumberBox Width="86" Minimum="0" Maximum="20" SmallChange="1" MaxDecimalPlaces="1"
                              Value="{Binding CornerRadius, Mode=TwoWay}" />
                <TextBlock Text="px" Margin="6,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
            <Separator />
            <Expander x:Name="ColorsRow" Header="Panel colours" Tag="panel colors colours swatches background title text warning graph">
              <ItemsControl ItemsSource="{Binding Colors}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid MinHeight="46" Margin="0,1">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                      </Grid.ColumnDefinitions>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Label}" />
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Hint}" />
                      </StackPanel>
                      <Grid Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button Width="46" Height="30" Padding="3" Click="ColorButton_Click" ToolTip="Open colour picker"
                                AutomationProperties.Name="{Binding Label, StringFormat=Edit {0} colour}">
                          <Border Background="{Binding Swatch}" CornerRadius="4" BorderBrush="#55000000" BorderThickness="1" />
                        </Button>
                        <Popup IsOpen="{Binding IsPickerOpen, Mode=TwoWay}" StaysOpen="False" Placement="Right">
                          <Border Background="White" BorderBrush="#55000000" BorderThickness="1" CornerRadius="8" Padding="10">
                            <picker:PortableColorPicker Width="340" SelectedColor="{Binding Color, Mode=TwoWay}" ShowAlpha="True" />
                          </Border>
                        </Popup>
                      </Grid>
                      <TextBox Grid.Column="2" Text="{Binding Hex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                               VerticalAlignment="Center" Padding="7,5" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>
            <Button Content="Reset appearance defaults" HorizontalAlignment="Left" Margin="0,12,0,0"
                    Style="{StaticResource SubtleButton}" Click="ResetAppearance_Click" />
          </StackPanel>
        </Border>

        <Border x:Name="FrameCard" Style="{StaticResource SettingsCard}" Tag="collector fps frame data capture PresentMon lows ETW">
          <StackPanel>
            <TextBlock Text="FPS &amp; frame data" Style="{StaticResource SectionHeading}" />
            <Grid x:Name="TransportRow" Style="{StaticResource SettingsRow}" Tag="capture transport PresentMon service sdk">
              <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center"><TextBlock Text="Capture transport" /><TextBlock Text="PresentMon service connection mode." Style="{StaticResource Hint}" /></StackPanel>
              <ComboBox Grid.Column="1" Width="310" HorizontalAlignment="Left" ItemsSource="{Binding Transports}" SelectedItem="{Binding Transport, Mode=TwoWay}" />
            </Grid>
            <Separator />
            <Grid x:Name="TapRow" Style="{StaticResource SettingsRow}" Tag="presented tap DXGI D3D9 frame latency">
              <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center"><TextBlock Text="Presented tap" /><TextBlock Text="Low-latency stream where the title supports it." Style="{StaticResource Hint}" /></StackPanel>
              <ComboBox Grid.Column="1" Width="310" HorizontalAlignment="Left" ItemsSource="{Binding TapModes}" SelectedItem="{Binding PresentedTap, Mode=TwoWay}" />
            </Grid>
            <Separator />
            <Grid x:Name="FlushRow" Style="{StaticResource SettingsRow}" Tag="event flush period ms freshness CPU">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center"><TextBlock Text="Event flush period" /><TextBlock Text="0 uses the service default; 1–1000 ms trades CPU for freshness." Style="{StaticResource Hint}" /></StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal"><ui:NumberBox Width="96" Minimum="0" Maximum="1000" SmallChange="1" Value="{Binding EtwFlushMs, Mode=TwoWay}" /><TextBlock Text="ms" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
            </Grid>
            <Separator />
            <Grid x:Name="LowsRow" Style="{StaticResource SettingsRow}" Tag="one percent point one low rolling window seconds">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center"><TextBlock Text="1% / 0.1% lows window" /><TextBlock Text="Rolling sample window used for frame-rate lows." Style="{StaticResource Hint}" /></StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal"><ui:NumberBox Width="96" Minimum="10" Maximum="600" SmallChange="5" Value="{Binding FrameLowsWindowS, Mode=TwoWay}" /><TextBlock Text="s" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
            </Grid>
            <Button Content="Reset frame data settings" HorizontalAlignment="Left" Margin="0,8,0,0"
                    Style="{StaticResource SubtleButton}" Click="ResetCollector_Click" />
          </StackPanel>
        </Border>

        <Border x:Name="NetworkCard" Style="{StaticResource SettingsCard}" Tag="network adapter external IP internet privacy URL refresh">
          <StackPanel>
            <TextBlock Text="Network" Style="{StaticResource SectionHeading}" />
            <Grid x:Name="AdapterRow" Style="{StaticResource SettingsRow}" Tag="network adapter interface Best route">
              <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center"><TextBlock Text="Network adapter" /><TextBlock Text="Best follows the adapter with the default route." Style="{StaticResource Hint}" /></StackPanel>
              <ComboBox Grid.Column="1" Width="330" HorizontalAlignment="Left" IsEditable="True"
                        ItemsSource="{Binding NetworkInterfaces}" Text="{Binding NetworkInterface, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
            </Grid>
            <Separator />
            <Grid x:Name="ExternalIpRow" Style="{StaticResource SettingsRow}" Tag="external public IP internet request privacy">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center"><TextBlock Text="Look up my external IP" /><TextBlock Text="Off by default. This is Halo's only outbound web request." Style="{StaticResource Hint}" /></StackPanel>
              <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding ExternalIpEnabled, Mode=TwoWay}" OnContent="On" OffContent="Off" />
            </Grid>
            <Separator />
            <Grid x:Name="IpUrlRow" Style="{StaticResource SettingsRow}" Tag="external IP service URL ipify">
              <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Text="External IP service" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Text="{Binding ExternalIpUrl, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Padding="7,5" />
            </Grid>
            <Separator />
            <Grid x:Name="IpRefreshRow" Style="{StaticResource SettingsRow}" Tag="external IP refresh minutes interval">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="External IP refresh" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal"><ui:NumberBox Width="96" Minimum="1" Maximum="1440" SmallChange="1" Value="{Binding ExternalIpRefreshMinutes, Mode=TwoWay}" /><TextBlock Text="minutes" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
            </Grid>
            <Button Content="Reset network settings" HorizontalAlignment="Left" Margin="0,8,0,0"
                    Style="{StaticResource SubtleButton}" Click="ResetNetwork_Click" />
          </StackPanel>
        </Border>

        <Border x:Name="FilesCard" Style="{StaticResource SettingsCard}" Tag="layout files data folder export import reset settings widgets json">
          <StackPanel>
            <TextBlock Text="Layout files" Style="{StaticResource SectionHeading}" />
            <TextBlock Text="Export or import both settings.json and widgets.json as one Halo layout file." Style="{StaticResource Hint}" Margin="0,0,0,10" />
            <WrapPanel>
              <Button Content="Open data folder" Click="OpenDataFolder_Click" Style="{StaticResource SubtleButton}" />
              <Button Content="Export layout…" Click="ExportLayout_Click" Style="{StaticResource SubtleButton}" />
              <Button Content="Import layout…" Click="ImportLayout_Click" Style="{StaticResource SubtleButton}" />
            </WrapPanel>
            <Button Content="Reset everything…" Foreground="{StaticResource HaloDanger}" HorizontalAlignment="Left"
                    Margin="0,8,0,0" Style="{StaticResource SubtleButton}" Click="ResetEverything_Click" />
          </StackPanel>
        </Border>

        <TextBlock x:Name="NoSearchResults" Text="No settings match this search." Visibility="Collapsed"
                   Foreground="{StaticResource HaloSubtleText}" FontSize="14" Margin="0,8,0,24" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
