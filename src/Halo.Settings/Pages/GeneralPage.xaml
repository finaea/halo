<UserControl x:Class="Halo.Settings.Pages.GeneralPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:picker="clr-namespace:ColorPicker;assembly=ColorPicker">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>
  <Grid Background="{StaticResource HaloPageBackground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,22">
      <StackPanel MaxWidth="860" HorizontalAlignment="Left">
        <TextBlock Text="General" Style="{StaticResource PageTitle}" />
        <TextBlock Text="Desktop behaviour and defaults shared by every widget. Changes are written live."
                   Style="{StaticResource PageSub}" />

        <ui:InfoBar x:Name="PageInfoBar" IsOpen="False" IsClosable="True" Margin="0,0,0,12" />

        <Border Style="{StaticResource SettingsCard}">
          <StackPanel>
            <TextBlock Text="Desktop behaviour" Style="{StaticResource SectionHeading}" />
            <Grid Style="{StaticResource SettingsRow}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Start with Windows" />
                <TextBlock x:Name="AutostartStatusText" Text="Checking Collector and Widgets tasks…" Style="{StaticResource Hint}" />
              </StackPanel>
              <ui:ToggleSwitch x:Name="AutostartSwitch" Grid.Column="1" VerticalAlignment="Center"
                               OnContent="On" OffContent="Off" Click="AutostartSwitch_Click" />
            </Grid>
            <Separator />
            <Grid Style="{StaticResource SettingsRow}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Lock all widgets" />
                <TextBlock Text="Blocks dragging without changing each widget's own lock setting." Style="{StaticResource Hint}" />
              </StackPanel>
              <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding LockAll, Mode=TwoWay}"
                               OnContent="On" OffContent="Off" AutomationProperties.Name="Lock all widgets" />
            </Grid>
            <Separator />
            <Grid Style="{StaticResource SettingsRow}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Snap while moving" />
                <TextBlock Text="Pulls widgets to screen and widget edges while you drag." Style="{StaticResource Hint}" />
              </StackPanel>
              <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Snap, Mode=TwoWay}"
                               OnContent="On" OffContent="Off" AutomationProperties.Name="Snap while moving" />
            </Grid>
            <Button x:Name="RepairAutostartButton" Content="Repair autostart…  ⛨" HorizontalAlignment="Left"
                    Style="{StaticResource SubtleButton}" Margin="0,8,0,0" Click="RepairAutostart_Click"
                    ToolTip="Recreates both scheduled tasks and asks Windows for administrator permission." />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsCard}">
          <StackPanel>
            <TextBlock Text="Appearance defaults" Style="{StaticResource SectionHeading}" />
            <TextBlock Text="Theme presets write ordinary colours; you can change any swatch afterward." Style="{StaticResource Hint}" Margin="0,0,0,8" />
            <WrapPanel Margin="0,0,0,8">
              <ToggleButton Content="Rainformer" Tag="Rainformer" Click="Preset_Click"
                            Style="{StaticResource PresetChip}" IsChecked="{Binding IsRainformerPreset, Mode=OneWay}" />
              <ToggleButton Content="Light" Tag="Light" Click="Preset_Click"
                            Style="{StaticResource PresetChip}" IsChecked="{Binding IsLightPreset, Mode=OneWay}" />
              <ToggleButton Content="High contrast" Tag="High contrast" Click="Preset_Click"
                            Style="{StaticResource PresetChip}" IsChecked="{Binding IsHighContrastPreset, Mode=OneWay}" />
              <!-- Not clickable: "Custom" is a state you arrive at by editing a swatch, not one you apply. -->
              <Border Background="{StaticResource HaloPageBackground}" BorderBrush="{StaticResource HaloBorder}"
                      BorderThickness="1" CornerRadius="4" Padding="14,6" VerticalAlignment="Center"
                      Visibility="{Binding IsCustomPalette, Converter={StaticResource BoolToVisibility}}"
                      ToolTip="These colours match none of the presets.">
                <TextBlock Text="Custom" Foreground="{StaticResource HaloSubtleText}" />
              </Border>
            </WrapPanel>
            <Separator />
            <Grid Style="{StaticResource SettingsRow}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Scale" />
                <TextBlock Text="{Binding ScaleSummary}" Style="{StaticResource Hint}" />
              </StackPanel>
              <Slider Grid.Column="1" Minimum="1" Maximum="3.5" TickFrequency="0.05" IsSnapToTickEnabled="True"
                      Value="{Binding FixedScale, Mode=TwoWay}" IsEnabled="{Binding IsFixedScaleEnabled}" Margin="8,0" />
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:NumberBox Minimum="1" Maximum="3.5" SmallChange="0.05" MaxDecimalPlaces="2"
                              Value="{Binding FixedScale, Mode=TwoWay}" IsEnabled="{Binding IsFixedScaleEnabled}" />
                <ui:ToggleSwitch Margin="10,0,0,0" IsChecked="{Binding AutoScale, Mode=TwoWay}" OnContent="Auto" OffContent="Fixed" />
              </StackPanel>
            </Grid>
            <Separator />
            <Grid Style="{StaticResource SettingsRow}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="Font and text size" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" Width="260" HorizontalAlignment="Left" IsEditable="True"
                        ItemsSource="{Binding FontFamilies}" Text="{Binding FontFamily, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:NumberBox Minimum="5" Maximum="24" SmallChange="0.5" MaxDecimalPlaces="1"
                              Value="{Binding TextSizePt, Mode=TwoWay}" />
                <TextBlock Text="pt" Margin="6,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
            <Separator />
            <Grid Style="{StaticResource SettingsRow}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="Corner radius" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:NumberBox Minimum="0" Maximum="20" SmallChange="1" MaxDecimalPlaces="1"
                              Value="{Binding CornerRadius, Mode=TwoWay}" />
                <TextBlock Text="px" Margin="6,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
            <Separator />
            <Expander Header="Panel colours">
              <ItemsControl ItemsSource="{Binding Colors}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid MinHeight="46" Margin="0,1">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                      </Grid.ColumnDefinitions>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Label}" />
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Hint}" />
                      </StackPanel>
                      <Grid Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <!-- The swatch Border has no child, so it has no desired size of its own and
                             WPF-UI's centred content presenter measured it to nothing — that is the
                             "dot" the button used to render as. Size it explicitly. -->
                        <Button Width="46" Height="30" Padding="3" Click="ColorButton_Click" ToolTip="Open colour picker"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                AutomationProperties.Name="{Binding Label, StringFormat=Edit {0} colour}">
                          <Border Width="36" Height="20" Background="{Binding Swatch}" CornerRadius="4"
                                  BorderBrush="#55000000" BorderThickness="1" />
                        </Button>
                        <Popup IsOpen="{Binding IsPickerOpen, Mode=TwoWay}" StaysOpen="False" Placement="Right"
                               AllowsTransparency="True" PopupAnimation="Fade">
                          <Border Background="White" BorderBrush="#55000000" BorderThickness="1" CornerRadius="8" Padding="10">
                            <!-- PixiEditor 3.4.2.3 ships two different things: PortableColorPicker is the
                                 collapsible launcher (a swatch button plus its own popup) and measures
                                 340x1.6 when it is given a Width and no Height, i.e. a bare line; the real
                                 picker surface is StandardColorPicker. Its own tight internal sizes (a 50px
                                 combo, 40px value boxes, a 70px hex box) assume compact chrome, so WPF-UI's
                                 implicit styles are reset to stock WPF inside this popup or those children
                                 render empty the same way the NumberBox did. -->
                            <Border.Resources>
                              <Style TargetType="TextBox"><Setter Property="FontSize" Value="11" /><Setter Property="Padding" Value="1,0" /></Style>
                              <Style TargetType="ComboBox"><Setter Property="FontSize" Value="11" /><Setter Property="Padding" Value="2,0" /></Style>
                              <Style TargetType="ComboBoxItem"><Setter Property="FontSize" Value="11" /></Style>
                              <Style TargetType="TextBlock"><Setter Property="FontSize" Value="11" /></Style>
                              <Style TargetType="TabControl" />
                              <Style TargetType="TabItem" />
                              <Style TargetType="Slider" />
                              <Style TargetType="Button" />
                              <Style TargetType="ToggleButton" />
                            </Border.Resources>
                            <picker:StandardColorPicker Width="320" Height="430" ShowAlpha="True" ShowFractionalPart="False"
                                                        SelectedColor="{Binding Color, Mode=TwoWay}" />
                          </Border>
                        </Popup>
                      </Grid>
                      <TextBox Grid.Column="2" Text="{Binding Hex, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                               VerticalAlignment="Center" Padding="7,5" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>
            <Button Content="Reset appearance defaults" HorizontalAlignment="Left" Margin="0,12,0,0"
                    Style="{StaticResource SubtleButton}" Click="ResetAppearance_Click" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource SettingsCard}">
          <StackPanel>
            <TextBlock Text="Layout files" Style="{StaticResource SectionHeading}" />
            <TextBlock Text="Export or import both settings.json and widgets.json as one Halo layout file." Style="{StaticResource Hint}" Margin="0,0,0,10" />
            <WrapPanel>
              <Button Content="Open data folder" Click="OpenDataFolder_Click" Style="{StaticResource SubtleButton}" />
              <Button Content="Export layout…" Click="ExportLayout_Click" Style="{StaticResource SubtleButton}" />
              <Button Content="Import layout…" Click="ImportLayout_Click" Style="{StaticResource SubtleButton}" />
            </WrapPanel>
            <Button Content="Reset everything…" Foreground="{StaticResource HaloDanger}" HorizontalAlignment="Left"
                    Margin="0,8,0,0" Style="{StaticResource SubtleButton}" Click="ResetEverything_Click" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
