<UserControl x:Class="Halo.Settings.Pages.GeneralPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14">
    <StackPanel>
      <TextBlock Text="General" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="210"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Default rate (Hz, 1..100)"/>
        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="DefaultRateBox" Width="120" HorizontalAlignment="Left" Margin="0,4"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Scale (0.5..3)"/>
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
          <Slider x:Name="ScaleSlider" Width="260" Minimum="0.5" Maximum="3"
                  TickFrequency="0.1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
          <TextBlock Margin="10,0,0,0" Text="{Binding Value, ElementName=ScaleSlider, StringFormat={}{0:0.0}}"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Font family"/>
        <TextBox   Grid.Row="2" Grid.Column="1" x:Name="FontBox" Width="260" HorizontalAlignment="Left" Margin="0,4"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Frame lows window (s)"/>
        <TextBox   Grid.Row="3" Grid.Column="1" x:Name="FrameLowsBox" Width="120" HorizontalAlignment="Left" Margin="0,4"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Graph history (s)"/>
        <TextBox   Grid.Row="4" Grid.Column="1" x:Name="GraphHistoryBox" Width="120" HorizontalAlignment="Left" Margin="0,4"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="External IP URL"/>
        <TextBox   Grid.Row="5" Grid.Column="1" x:Name="IpUrlBox" Width="360" HorizontalAlignment="Left" Margin="0,4"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="External IP refresh (min)"/>
        <TextBox   Grid.Row="6" Grid.Column="1" x:Name="IpRefreshBox" Width="120" HorizontalAlignment="Left" Margin="0,4"/>

        <TextBlock Grid.Row="7" Grid.Column="0" Text="Drive letters (comma-separated)"/>
        <TextBox   Grid.Row="7" Grid.Column="1" x:Name="DrivesBox" Width="360" HorizontalAlignment="Left" Margin="0,4"/>

        <TextBlock Grid.Row="8" Grid.Column="0" Text="Network interface"/>
        <TextBox   Grid.Row="8" Grid.Column="1" x:Name="NetIfBox" Width="260" HorizontalAlignment="Left" Margin="0,4"/>

        <TextBlock Grid.Row="9" Grid.Column="0" Text="Top process count"/>
        <TextBox   Grid.Row="9" Grid.Column="1" x:Name="TopProcBox" Width="120" HorizontalAlignment="Left" Margin="0,4"/>

        <CheckBox  Grid.Row="10" Grid.Column="1" x:Name="LockAllCheck" Content="Lock all widgets" Margin="0,6"/>
      </Grid>

      <Grid Margin="0,14,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="20"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Grid.Column="0" Header="Fan names (channel → nickname)">
          <DataGrid x:Name="FanNamesGrid" CanUserAddRows="True" CanUserDeleteRows="True" Height="190">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Channel" Binding="{Binding Key}" Width="100"/>
              <DataGridTextColumn Header="Name" Binding="{Binding Value}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </GroupBox>

        <GroupBox Grid.Column="2" Header="Fan max RPM (channel → rpm)">
          <DataGrid x:Name="FanMaxRpmGrid" CanUserAddRows="True" CanUserDeleteRows="True" Height="190">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Channel" Binding="{Binding Key}" Width="100"/>
              <DataGridTextColumn Header="Max RPM" Binding="{Binding Value}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </GroupBox>
      </Grid>

      <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
        <Button Content="Save" Click="Save_Click"/>
        <Button Content="Reset session maxima" Click="ResetMax_Click"/>
        <Button Content="Reset network totals" Click="ResetNet_Click"/>
      </StackPanel>

      <TextBlock x:Name="Status" Foreground="{StaticResource Sub}" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
