<UserControl x:Class="Halo.Settings.Pages.GeneralPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Halo.Settings">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14">
    <StackPanel MaxWidth="860" HorizontalAlignment="Left">
      <TextBlock Text="General" Style="{StaticResource PageTitle}"/>
      <TextBlock Style="{StaticResource PageSub}"
                 Text="Global settings for all widgets and the data collector. Changes apply live after Save — no restart needed."/>

      <GroupBox Header="Appearance">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="Widget scale" Style="{StaticResource RowLabel}"/>
          <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
            <Slider x:Name="ScaleSlider" Width="240" Minimum="0.5" Maximum="3"
                    TickFrequency="0.1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
            <TextBlock Margin="10,0,0,0" Width="34"
                       Text="{Binding Value, ElementName=ScaleSlider, StringFormat={}{0:0.0}}"/>
          </StackPanel>
          <local:HelpTip Grid.Row="0" Grid.Column="2"
                         Tip="Size multiplier for every widget. Layouts are designed in logical units; 1.7 reproduces the original Rainformer proportions. Applies to all widgets at once."/>

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Font" Style="{StaticResource RowLabel}"/>
          <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="FontCombo" Width="240" IsEditable="True"
                     HorizontalAlignment="Left" Margin="0,4"/>
          <local:HelpTip Grid.Row="1" Grid.Column="2"
                         Tip="Font family used for all widget text. The original skin uses Trebuchet MS. Icons come from bundled icon fonts and are not affected."/>

          <CheckBox Grid.Row="2" Grid.Column="1" x:Name="LockAllCheck" Content="Lock all widgets" Margin="0,6"/>
          <local:HelpTip Grid.Row="2" Grid.Column="2"
                         Tip="Blocks dragging for every widget at once. Same switch as 'Lock all widgets' in a widget's right-click menu. Individual widgets can also be locked on the Widgets page."/>
        </Grid>
      </GroupBox>

      <GroupBox Header="Update rate">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0" Text="Default rate (Hz)" Style="{StaticResource RowLabel}"/>
          <TextBox   Grid.Column="1" x:Name="DefaultRateBox" Width="80" HorizontalAlignment="Left" Margin="0,4"/>
          <local:HelpTip Grid.Column="2"
                         Tip="How many times per second widgets repaint and most sensors publish (CPU, GPU, RAM, disk, network…). Higher = smoother numbers but more CPU. FPS panels are not limited by this — frame data is event-driven. Per-widget override: Widgets page → Rate."/>
          <TextBlock Grid.Column="3" Style="{StaticResource Hint}" Margin="12,0,0,0"
                     Text="1–100 · default 5 · fps counters update live regardless"/>
        </Grid>
      </GroupBox>

      <GroupBox Header="FPS &amp; frame data">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="Capture transport" Style="{StaticResource RowLabel}"/>
          <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="TransportCombo" Width="240" HorizontalAlignment="Left" Margin="0,4"/>
          <local:HelpTip Grid.Row="0" Grid.Column="2"
                         Tip="How frame timing is captured for the DISPLAYED panel and 1%/0.1% lows.&#x0a;&#x0a;• Service + SDK — bundled PresentMon 2 service, lowest latency (default).&#x0a;• Console app — PresentMon capture app over stdout; slower but simplest.&#x0a;• Auto — SDK first, console as fallback if the service fails."/>

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Presented tap" Style="{StaticResource RowLabel}"/>
          <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="TapCombo" Width="240" HorizontalAlignment="Left" Margin="0,4"/>
          <local:HelpTip Grid.Row="1" Grid.Column="2"
                         Tip="Dedicated event tap on DXGI/D3D9 Present calls feeding the PRESENTED fps panel with near-zero latency (RTSS-like feel, nothing injected into the game). Vulkan/OpenGL titles automatically fall back to the capture transport above. 'Off' uses the capture transport for both panels."/>

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Event flush period (ms)" Style="{StaticResource RowLabel}"/>
          <TextBox   Grid.Row="2" Grid.Column="1" x:Name="EtwFlushBox" Width="80" HorizontalAlignment="Left" Margin="0,4"/>
          <local:HelpTip Grid.Row="2" Grid.Column="2"
                         Tip="How often Windows hands queued frame events to Halo while a game is tracked (1–1000 ms). Lower = fresher fps/frametime numbers for slightly more CPU. Relaxes automatically ~10 s after the game stops presenting."/>
          <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource Hint}" Margin="12,0,0,0"
                     Text="default 10 ms"/>

          <TextBlock Grid.Row="3" Grid.Column="0" Text="1% / 0.1% lows window (s)" Style="{StaticResource RowLabel}"/>
          <TextBox   Grid.Row="3" Grid.Column="1" x:Name="FrameLowsBox" Width="80" HorizontalAlignment="Left" Margin="0,4"/>
          <local:HelpTip Grid.Row="3" Grid.Column="2"
                         Tip="Rolling window used to compute 1% and 0.1% low FPS. 60 s matches the RTSS / CapFrameX convention."/>

          <TextBlock Grid.Row="4" Grid.Column="0" Text="Graph history (s)" Style="{StaticResource RowLabel}"/>
          <TextBox   Grid.Row="4" Grid.Column="1" x:Name="GraphHistoryBox" Width="80" HorizontalAlignment="Left" Margin="0,4"/>
          <local:HelpTip Grid.Row="4" Grid.Column="2"
                         Tip="How many seconds of history the slow graphs keep (CPU, GPU, network…). Frametime graphs are per-frame and unaffected."/>
        </Grid>
      </GroupBox>

      <GroupBox Header="Network">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="Network adapter" Style="{StaticResource RowLabel}"/>
          <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="NetIfCombo" Width="300" IsEditable="True"
                     HorizontalAlignment="Left" Margin="0,4"/>
          <local:HelpTip Grid.Row="0" Grid.Column="2"
                         Tip="Which adapter the NETWORK widget follows. 'Best' automatically tracks the adapter that owns the default route (switches when you change networks). Pick a specific adapter to pin it."/>

          <TextBlock Grid.Row="1" Grid.Column="0" Text="External IP service" Style="{StaticResource RowLabel}"/>
          <TextBox   Grid.Row="1" Grid.Column="1" x:Name="IpUrlBox" Width="300" HorizontalAlignment="Left" Margin="0,4"/>
          <local:HelpTip Grid.Row="1" Grid.Column="2"
                         Tip="URL that returns your public IP as plain text. Queried in the background at the interval below; the result shows on the NETWORK widget."/>

          <TextBlock Grid.Row="2" Grid.Column="0" Text="External IP refresh (min)" Style="{StaticResource RowLabel}"/>
          <TextBox   Grid.Row="2" Grid.Column="1" x:Name="IpRefreshBox" Width="80" HorizontalAlignment="Left" Margin="0,4"/>
          <local:HelpTip Grid.Row="2" Grid.Column="2"
                         Tip="Minutes between public-IP lookups. Keep this high — it is a real web request each time."/>
        </Grid>
      </GroupBox>

      <GroupBox Header="Drives &amp; processes">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="Drives to show" Style="{StaticResource RowLabel}" VerticalAlignment="Top" Margin="0,8,12,0"/>
          <WrapPanel Grid.Row="0" Grid.Column="1" x:Name="DrivesPanel" Width="420" HorizontalAlignment="Left" Margin="0,4"/>
          <local:HelpTip Grid.Row="0" Grid.Column="2" VerticalAlignment="Top" Margin="7,8,0,0"
                         Tip="Which drive letters the DRIVES widget lists. Detected drives are shown here; a configured drive that is currently unplugged is kept and marked '(absent)' — it renders as N/A on the widget."/>

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Top process rows" Style="{StaticResource RowLabel}"/>
          <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TopProcBox" Width="80" HorizontalAlignment="Left" Margin="0,4"/>
          <local:HelpTip Grid.Row="1" Grid.Column="2"
                         Tip="Number of rows in the TOP CPU and TOP RAM widgets."/>
        </Grid>
      </GroupBox>

      <GroupBox Header="Fans">
        <StackPanel>
          <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                     Text="Channel = the motherboard fan header number reported by the SuperIO chip (the FANS widget shows unnamed channels as 'Fan #N'). Name gives it a label; Max RPM calibrates its percentage bar."/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="20"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DataGrid Grid.Column="0" x:Name="FanNamesGrid" CanUserAddRows="True" CanUserDeleteRows="True" Height="170">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Channel" Binding="{Binding Key}" Width="100"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Value}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
            <DataGrid Grid.Column="2" x:Name="FanMaxRpmGrid" CanUserAddRows="True" CanUserDeleteRows="True" Height="170">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Channel" Binding="{Binding Key}" Width="100"/>
                <DataGridTextColumn Header="Max RPM" Binding="{Binding Value}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </StackPanel>
      </GroupBox>

      <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
        <Button Content="Save" Click="Save_Click" FontWeight="SemiBold" Padding="20,5"/>
        <Button Content="Reset session maxima" Click="ResetMax_Click"
                ToolTip="Clears every session-maximum readout (the small grey 'max' values on the widgets). Sent to the running collector."/>
        <Button Content="Reset network totals" Click="ResetNet_Click"
                ToolTip="Clears the session upload/download totals on the NETWORK widget. Sent to the running collector."/>
      </StackPanel>

      <TextBlock x:Name="Status" Foreground="{StaticResource Sub}" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
