<UserControl x:Class="Halo.Settings.Pages.GeneralPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Halo.Settings">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14">
    <StackPanel MaxWidth="860" HorizontalAlignment="Left">
      <TextBlock Text="General" Style="{StaticResource PageTitle}"/>
      <TextBlock Style="{StaticResource PageSub}"
                 Text="Settings that are not per widget. Hardware lists live on each widget now — the collector publishes every GPU, fan and volume it finds and each widget picks what it shows."/>

      <GroupBox Header="Appearance">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="Widget scale" Style="{StaticResource RowLabel}"/>
          <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
            <CheckBox x:Name="AutoScaleCheck" Content="Auto" VerticalAlignment="Center" Margin="0,0,10,0"
                      Checked="AutoScale_Changed" Unchecked="AutoScale_Changed"/>
            <Slider x:Name="ScaleSlider" Width="200" Minimum="1.0" Maximum="3.5"
                    TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
            <TextBlock Margin="10,0,0,0" Width="40"
                       Text="{Binding Value, ElementName=ScaleSlider, StringFormat={}{0:0.00}}"/>
          </StackPanel>
          <local:HelpTip Grid.Row="0" Grid.Column="2"
                         Tip="Size multiplier for every widget. Auto picks a scale from the monitor's size so a panel takes the same fraction of any screen; a fixed number pins it (1.7 reproduces the original Rainformer proportions on a 1080p-class monitor)."/>

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Font" Style="{StaticResource RowLabel}"/>
          <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="FontCombo" Width="240" IsEditable="True"
                     HorizontalAlignment="Left" Margin="0,4"/>
          <local:HelpTip Grid.Row="1" Grid.Column="2"
                         Tip="Font family used for all widget text. The original skin uses Trebuchet MS. Icons come from bundled icon fonts and are not affected."/>

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Text size (pt)" Style="{StaticResource RowLabel}"/>
          <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TextSizeBox" Width="80" HorizontalAlignment="Left" Margin="0,4"/>
          <local:HelpTip Grid.Row="2" Grid.Column="2"
                         Tip="Base text size in points before the scale multiplier. The extracted layouts assume 8 pt."/>

          <TextBlock Grid.Row="3" Grid.Column="0" Text="Corner radius" Style="{StaticResource RowLabel}"/>
          <TextBox   Grid.Row="3" Grid.Column="1" x:Name="CornerRadiusBox" Width="80" HorizontalAlignment="Left" Margin="0,4"/>
          <local:HelpTip Grid.Row="3" Grid.Column="2"
                         Tip="Rounding of the panel card corners, in logical units (4 = the original skin)."/>

          <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
            <CheckBox x:Name="LockAllCheck" Content="Lock all widgets" Margin="0,6,16,6"/>
            <CheckBox x:Name="SnapCheck" Content="Snap while dragging" Margin="0,6"/>
          </StackPanel>
          <local:HelpTip Grid.Row="4" Grid.Column="2"
                         Tip="Lock blocks dragging for every widget at once (same switch as the widget right-click menu). Snap pulls a dragged widget to screen and widget edges within 8 px."/>
        </Grid>
      </GroupBox>

      <GroupBox Header="FPS &amp; frame data">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="Capture transport" Style="{StaticResource RowLabel}"/>
          <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="TransportCombo" Width="240" HorizontalAlignment="Left" Margin="0,4"/>
          <local:HelpTip Grid.Row="0" Grid.Column="2"
                         Tip="How frame timing is captured for the DISPLAYED panel and 1%/0.1% lows. The bundled PresentMon 2 service is the only transport; Auto simply means &quot;use it if it starts&quot;."/>

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Presented tap" Style="{StaticResource RowLabel}"/>
          <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="TapCombo" Width="240" HorizontalAlignment="Left" Margin="0,4"/>
          <local:HelpTip Grid.Row="1" Grid.Column="2"
                         Tip="Dedicated event tap on DXGI/D3D9 Present calls feeding the PRESENTED fps panel with near-zero latency (RTSS-like feel, nothing injected into the game). Vulkan/OpenGL titles automatically fall back to the capture transport above."/>

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Event flush period (ms)" Style="{StaticResource RowLabel}"/>
          <TextBox   Grid.Row="2" Grid.Column="1" x:Name="EtwFlushBox" Width="80" HorizontalAlignment="Left" Margin="0,4"/>
          <local:HelpTip Grid.Row="2" Grid.Column="2"
                         Tip="How often Windows hands queued frame events to Halo while a game is tracked (1–1000 ms). Lower = fresher fps/frametime numbers for slightly more CPU. Relaxes automatically ~10 s after the game stops presenting."/>
          <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource Hint}" Margin="12,0,0,0"
                     Text="default 10 ms"/>

          <TextBlock Grid.Row="3" Grid.Column="0" Text="1% / 0.1% lows window (s)" Style="{StaticResource RowLabel}"/>
          <TextBox   Grid.Row="3" Grid.Column="1" x:Name="FrameLowsBox" Width="80" HorizontalAlignment="Left" Margin="0,4"/>
          <local:HelpTip Grid.Row="3" Grid.Column="2"
                         Tip="Rolling window used to compute 1% and 0.1% low FPS. 60 s matches the RTSS / CapFrameX convention."/>
        </Grid>
      </GroupBox>

      <GroupBox Header="Network">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="Network adapter" Style="{StaticResource RowLabel}"/>
          <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="NetIfCombo" Width="300" IsEditable="True"
                     HorizontalAlignment="Left" Margin="0,4"/>
          <local:HelpTip Grid.Row="0" Grid.Column="2"
                         Tip="Which adapter the NETWORK widget follows. 'Best' automatically tracks the adapter that owns the default route (switches when you change networks). Pick a specific adapter to pin it."/>

          <CheckBox Grid.Row="1" Grid.Column="1" x:Name="ExternalIpCheck" Content="Look up my external IP" Margin="0,6"/>
          <local:HelpTip Grid.Row="1" Grid.Column="2"
                         Tip="Off by default. This is the only request Halo ever sends to the internet: it asks the service below for your public IP and shows it on the NETWORK widget. Nothing else leaves your PC."/>

          <TextBlock Grid.Row="2" Grid.Column="0" Text="External IP service" Style="{StaticResource RowLabel}"/>
          <TextBox   Grid.Row="2" Grid.Column="1" x:Name="IpUrlBox" Width="300" HorizontalAlignment="Left" Margin="0,4"/>
          <local:HelpTip Grid.Row="2" Grid.Column="2"
                         Tip="URL that returns your public IP as plain text."/>

          <TextBlock Grid.Row="3" Grid.Column="0" Text="External IP refresh (min)" Style="{StaticResource RowLabel}"/>
          <TextBox   Grid.Row="3" Grid.Column="1" x:Name="IpRefreshBox" Width="80" HorizontalAlignment="Left" Margin="0,4"/>
          <local:HelpTip Grid.Row="3" Grid.Column="2"
                         Tip="Minutes between public-IP lookups. Keep this high — it is a real web request each time."/>
        </Grid>
      </GroupBox>

      <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
        <Button Content="Save" Click="Save_Click" FontWeight="SemiBold" Padding="20,5"/>
        <Button Content="Reset session maxima" Click="ResetMax_Click"
                ToolTip="Clears every session-maximum readout (the small grey 'max' values on the widgets). Sent to the running collector."/>
        <Button Content="Reset network totals" Click="ResetNet_Click"
                ToolTip="Clears the session upload/download totals on the NETWORK widget. Sent to the running collector."/>
        <Button Content="Open data folder" Click="OpenDataFolder_Click"
                ToolTip="Opens the folder holding settings.json, widgets.json and the logs."/>
      </StackPanel>

      <TextBlock x:Name="Status" Foreground="{StaticResource Sub}" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
