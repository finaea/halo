<ui:FluentWindow x:Class="Halo.Settings.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:services="clr-namespace:Halo.Settings.Services"
                 Title="Halo Settings"
                 Icon="pack://application:,,,/assets/halo.ico"
                 Width="1040" Height="680" MinWidth="900" MinHeight="600"
                 WindowStartupLocation="CenterScreen"
                 Background="{StaticResource HaloPageBackground}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="216" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="30" />
    </Grid.RowDefinitions>

    <!-- FluentWindow draws no native caption, so without a ui:TitleBar the window has no
         minimise/maximise/close buttons at all and can only be closed with Alt+F4. -->
    <Border Grid.Row="0" Grid.ColumnSpan="2"
            Background="{StaticResource HaloPaneBackground}"
            BorderBrush="{StaticResource HaloBorder}" BorderThickness="0,0,0,1">
      <!-- Branding goes in Header, not in Icon/Title. TitleBar's own PART_Icon is an Image with a
           hard Width="16", so anything larger assigned to Icon is clipped, and Title renders at the
           system caption size with no way to ask for more. Header is a free content slot at the
           left of the same bar, so this keeps the old 18pt SemiBold heading and a legible icon
           while the caption buttons stay where the template puts them. Leaving Icon unset collapses
           PART_Icon; leaving Title unset leaves the caption TextBlock empty. Height stays 44 to
           match the TitleBarButton style, which pins the buttons to the top of the bar.
           IsHitTestVisible="False" so click-drag and double-click-to-maximise still reach the bar. -->
      <ui:TitleBar x:Name="WindowTitleBar" Height="44"
                   ShowMinimize="True" ShowMaximize="True" ShowClose="True">
        <ui:TitleBar.Header>
          <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center"
                      IsHitTestVisible="False">
            <!-- AppIcon.Large, not a plain Source: WPF picks halo.ico's 16-px frame otherwise. -->
            <Image Source="{x:Static services:AppIcon.Large}" Width="28" Height="28"
                   Margin="0,0,10,0" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="Halo Settings" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
        </ui:TitleBar.Header>
      </ui:TitleBar>
    </Border>

    <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource HaloPaneBackground}"
            BorderBrush="{StaticResource HaloBorder}" BorderThickness="0,0,1,0">
      <ListBox x:Name="Navigation" Margin="8" BorderThickness="0" Background="Transparent"
               SelectionChanged="Navigation_SelectionChanged">
        <ListBoxItem Tag="general" Padding="12,9" Margin="0,2"><TextBlock Text="General" /></ListBoxItem>
        <ListBoxItem Tag="system" Padding="12,9" Margin="0,2"><TextBlock Text="System check" /></ListBoxItem>
        <ListBoxItem Tag="widgets" Padding="12,9" Margin="0,2"><TextBlock Text="Widgets" /></ListBoxItem>
        <ListBoxItem IsEnabled="False" Height="18" />
        <ListBoxItem Tag="about" Padding="12,9" Margin="0,2"><TextBlock Text="About" /></ListBoxItem>
      </ListBox>
    </Border>

    <ContentControl x:Name="PageHost" Grid.Row="1" Grid.Column="1" />

    <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource HaloPaneBackground}"
            BorderBrush="{StaticResource HaloBorder}" BorderThickness="0,1,0,0">
      <Grid Margin="14,0">
        <TextBlock x:Name="ConfigPathText" VerticalAlignment="Center" FontSize="11"
                   Foreground="{StaticResource HaloSubtleText}" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="SaveStatusText" HorizontalAlignment="Right" VerticalAlignment="Center"
                   FontSize="11" Foreground="{StaticResource HaloSuccess}" />
      </Grid>
    </Border>
  </Grid>
</ui:FluentWindow>
