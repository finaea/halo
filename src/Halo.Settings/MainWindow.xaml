<Window x:Class="Halo.Settings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Halo Settings" Height="740" Width="1060"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" Padding="16,10"
            BorderBrush="{StaticResource Edge}" BorderThickness="0,0,0,1">
      <StackPanel>
        <TextBlock Text="Halo Settings" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock x:Name="ConfigPathText" Foreground="{StaticResource Sub}" FontSize="11"/>
      </StackPanel>
    </Border>

    <ListBox x:Name="Nav" DockPanel.Dock="Left" Width="150"
             BorderBrush="{StaticResource Edge}" BorderThickness="0,0,1,0"
             SelectionChanged="Nav_SelectionChanged" Padding="0,6">
      <ListBoxItem Content="General"/>
      <ListBoxItem Content="Widgets"/>
      <ListBoxItem Content="Theme"/>
      <ListBoxItem Content="Metrics"/>
      <ListBoxItem Content="Autostart"/>
    </ListBox>

    <ContentControl x:Name="Host"/>
  </DockPanel>
</Window>
