<Application x:Class="Halo.Settings.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Light" />
        <ui:ControlsDictionary />
      </ResourceDictionary.MergedDictionaries>

      <SolidColorBrush x:Key="HaloPageBackground" Color="#F3F3F3" />
      <SolidColorBrush x:Key="HaloPaneBackground" Color="#F7F7F7" />
      <SolidColorBrush x:Key="HaloCardBackground" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="HaloBorder" Color="#16000000" />
      <SolidColorBrush x:Key="HaloSubtleText" Color="#9E000000" />
      <SolidColorBrush x:Key="HaloSuccess" Color="#0F7B4D" />
      <SolidColorBrush x:Key="HaloDanger" Color="#B42318" />

      <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,4" />
      </Style>
      <Style x:Key="PageSub" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource HaloSubtleText}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,18" />
      </Style>
      <Style x:Key="SectionHeading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,6" />
      </Style>
      <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource HaloSubtleText}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
      <Style x:Key="SettingsCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource HaloCardBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource HaloBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="18,14" />
        <Setter Property="Margin" Value="0,0,0,12" />
      </Style>
      <Style x:Key="SettingsRow" TargetType="Grid">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Margin" Value="0,2" />
      </Style>
      <Style x:Key="SubtleButton" TargetType="Button">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="0,0,8,0" />
      </Style>

      <!-- WPF-UI 4.3 lays the inline spin buttons out INSIDE the NumberBox's content area: two
           24-unit RepeatButtons plus the (still measured) compact flyout make 76 units, and the
           control's own 10,8,10,7 padding adds 20 more. Give the control a hard Width and that
           chrome wins: at Width="86" the text host measures 0 and the box renders empty even
           though Value and Text are both correct.

           So the rule is NEVER GIVE A NumberBox A HARD Width. Left to size itself it measures 128
           and can never clip. MinWidth below 128 therefore does nothing; 132 is the first value
           that binds, and it only earns its keep if someone later drops a NumberBox into a
           constrained Grid column where the control cannot grow. For reference, a 4-character
           value ("3.45", "23.5") needs 25.7 units of text area; a hard Width of 116 leaves 17.6
           and 120 leaves 22.4, so both of those clip.

           ClearButtonEnabled=False is not about clipping: the clear button appears on focus and
           makes the box jump 128 -> 155, visibly shoving the row as you click into it. It is also
           meaningless on a spinner that has a Minimum. Off keeps the width stable.

           Keyed, not implicit: an implicit style keyed {x:Type ui:NumberBox} sitting next to
           ui:ControlsDictionary in this same dictionary shadows WPF-UI's own entry, and its
           BasedOn then resolves to itself, so the control loses the Fluent template and the spin
           buttons with it. -->
      <Style x:Key="SettingsNumberBox" TargetType="{x:Type ui:NumberBox}"
             BasedOn="{StaticResource {x:Type ui:NumberBox}}">
        <Setter Property="MinWidth" Value="132" />
        <Setter Property="ClearButtonEnabled" Value="False" />
      </Style>

      <!-- Appearance preset chips: checked state comes from the view model, clicking applies. -->
      <Style x:Key="PresetChip" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="MinWidth" Value="0" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
