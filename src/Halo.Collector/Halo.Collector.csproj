<?xml version="1.0" encoding="utf-8"?>
<!-- Halo Collector: elevated sensor-data process. See docs\architecture.md.
     Note: 2026-07-19 Defender ML false-positive (Bearfoos.A!ml) quarantined this file once;
     content is plain MSBuild XML. If it happens again, restore from git and consider an
     exclusion for this folder (user decision). -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- WinExe: no console window when the scheduled task launches it interactively.
         Diagnostics still work via piping the dump switch output in PowerShell. -->
    <OutputType>WinExe</OutputType>
    <RootNamespace>Halo.Collector</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\halo.ico</ApplicationIcon>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Halo.Metrics\Halo.Metrics.csproj" />
    <ProjectReference Include="..\Halo.Shared\Halo.Shared.csproj" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <!-- ETW real-time consumer for NVIDIA PCL Stats markers (true Reflex PC latency + render rate) -->
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.5" />
  </ItemGroup>
  <ItemGroup>
    <!-- Everything the exe reads at runtime is resolved from its own folder (Halo.Shared.Paths),
         so the build output has to be a complete, runnable layout — the same one the installer
         ships. The PresentMon SDK binaries ARE committed (MIT, ~5.4 MB — .gitignore spells out
         why), so a fresh clone builds a working frame pipeline with no extra download. -->
    <Content Include="..\..\tools\presentmon\sdk\**\*.*" LinkBase="presentmon" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\halo.ico" Link="assets\halo.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
