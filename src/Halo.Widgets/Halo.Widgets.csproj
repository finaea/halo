<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Halo.Widgets</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\halo.ico</ApplicationIcon>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TieredPgo>true</TieredPgo>
  </PropertyGroup>
  <ItemGroup>
    <!-- SkinAssets' folder-taking constructor and RenderContext.DigitAdvance are test seams -->
    <InternalsVisibleTo Include="Halo.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Halo.Metrics\Halo.Metrics.csproj" />
    <ProjectReference Include="..\Halo.Shared\Halo.Shared.csproj" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>
  <ItemGroup>
    <!-- Ships as the package's IL, not ReadyToRun. The R2R build of SharpGen.Runtime.COM 2.4.2-beta
         is the one file in a release VirusTotal flags (DeepInstinct, bare "MALICIOUS"); the package's
         own lib\net9.0 copy is clean. Measured 2026-10-04 on 1.0.3 + main 4808172. -->
    <PublishReadyToRunExclude Include="SharpGen.Runtime.COM.dll" />
  </ItemGroup>
  <ItemGroup>
    <!-- Fonts and the tray icon are read from <app root>\assets at runtime (Halo.Shared.Paths),
         so they must land next to the exe in every build and publish. -->
    <Content Include="..\..\assets\fonts\*.ttf" LinkBase="assets\fonts" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\halo.ico" Link="assets\halo.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- Skin fonts and art (Dx.LoadFonts, SkinAssets). build.ps1 copies the whole assets tree for a
         release anyway; this is what puts them next to a Debug exe and the render harness. -->
    <Content Include="..\..\assets\skins\**\*" LinkBase="assets\skins" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Render-harness fixtures (the render verb). Embedded rather than copied, so nothing extra lands
         next to the exe in dist\app; resource name = Halo.Widgets.Harness.Fixtures.<name>.json. -->
    <EmbeddedResource Include="Harness\Fixtures\*.json" />
  </ItemGroup>
</Project>
