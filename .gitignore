*.user

# Personal / machine-specific notes. This repo is public (see README): these describe
# this exact box - absolute user paths, hardware layout, autostart specifics - and are
# deliberately kept local only.
docs/private/

# PawnIO_setup.exe is GPL-2.0-or-later. tools\build.ps1 fetches it from its official
# GitHub release and verifies the pinned SHA256 before staging it, so the binary itself
# does not live in git (THIRD-PARTY-NOTICES.md has the URL and the hash).
installer/redist/

# The Intel PresentMon 2 SDK under tools/presentmon/sdk/ IS committed (MIT, ~5.4 MB) -
# a clone has to be able to build a working frame pipeline. Nothing else under
# tools/presentmon/ should be.
tools/presentmon/*.exe
tools/presentmon/*.msi
