<Project>
  <PropertyGroup>
    <!-- .NET 10 LTS (packaging plan P6): .NET 9 support ends 2026-11-10. The SDK is pinned in
         global.json so all three exes publish against one identical runtime. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <!-- One version for the whole product: stamped into every assembly, into the metrics section
       header (sys.collector.version) and into the installer file name. -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Product>Halo</Product>
    <Company>Halo</Company>
    <Authors>Halo contributors</Authors>
  </PropertyGroup>
</Project>
